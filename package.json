{
  "name": "realfy",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "CRM SaaS para Inmobiliarias",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:e2e": "pnpm --filter @realfy/api test:e2e",
    "knip": "node scripts/knip-gate.mjs",
    "knip:baseline": "node scripts/knip-gate.mjs --update",
    "jscpd": "node scripts/jscpd-gate.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "bcrypt",
      "prisma",
      "sharp"
    ]
  },
  "devDependencies": {
    "jscpd": "4.3.0",
    "knip": "5.88.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  }
}
