{
  "name": "realfy",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "CRM SaaS para Inmobiliarias",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "test:e2e": "pnpm --filter @realfy/api test:e2e"
