      "@swc/core",
      "bcrypt",
      "prisma",
      "sharp"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  }
}
