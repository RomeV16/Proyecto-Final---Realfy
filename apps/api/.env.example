# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realfy_dev

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
# Vida del token de acceso. Formato de `ms` (15m, 1h, 7d).
JWT_ACCESS_EXPIRY=15m
# Vida del token de refresco, en días. Los refresh no son JWT: son
# identificadores opacos guardados en la tabla RefreshToken, y rotan en cada uso,
# así que no hay un secreto propio que firmarlos.
JWT_REFRESH_DAYS=7
# Domain for auth cookies (e.g. .realfy.app covers api.realfy.app + app.realfy.app)
COOKIE_DOMAIN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins: son los orígenes del FRONTEND, no el
# de esta API. En desarrollo la web corre en el 3000 y la API en el 3001.
# Si la variable no está definida se permite únicamente http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Set to 1 to disable throttling (useful for local dev and for the e2e suite).
# Se ignora cuando NODE_ENV=production, para que un entorno mal cargado no deje
# la API sin límite.
RATE_LIMIT_DISABLED=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Almacenamiento de objetos (S3 / MinIO) ───────────────────────────────────
# Fotos de propiedades y adjuntos. Sin un endpoint válido la carga de imágenes
# falla: es la única parte del sistema que no degrada en silencio.
# Para el MinIO de docker-compose, el endpoint es http://localhost:9000 y las
# credenciales son las que declara ese archivo.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=realfy-media

# ─── Correo (Resend) ──────────────────────────────────────────────────────────
# NEVER commit a real key. Sin credencial no se envía ningún correo: los
# servicios lo registran como advertencia y la operación se completa igual.
RESEND_API_KEY=
# Remitente de los correos salientes. Sin definir, cada tipo de correo usa su
# remitente por defecto.
RESEND_FROM_ADDRESS=

# ─── ARCA Crypto ──────────────────────────────────────────────────────────────
# Base64-encoded 32-byte master key for envelope encryption of ARCA certificates.
# Generate with: openssl rand -base64 32
# NEVER commit a real key. Rotate by re-wrapping DEKs (CryptoService.rotateKek).
# Only required to upload or use an ARCA certificate: the API boots without it.
ARCA_MASTER_KEY=

# ─── ARCA / facturación electrónica ───────────────────────────────────────────
# Set to 1 to answer WSAA/WSFEv1 calls from the in-repo simulator instead of AFIP.
# Use it for local dev and tests; leave empty to hit the real web services.
ARCA_MOCK=
# Token for AfipSDK's PDF template API. Without it the fiscal PDF falls back to
# the local pdfmake template.
ARCA_ACCESS_TOKEN=

# ─── Modelo de lenguaje ───────────────────────────────────────────────────────
# Endpoint compatible con `POST {AI_BASE_URL}/chat/completions` y autenticación
# `Authorization: Bearer <AI_API_KEY>`. Cambiar de proveedor es cambiar estas
# dos variables.
AI_BASE_URL=https://api.minimax.io/v1
AI_MODEL=MiniMax-M3
# NEVER commit a real key. Sin credencial la API levanta igual y las funciones
# que consultan al modelo resuelven por sus propias reglas.
AI_API_KEY=
# Tiempo máximo de espera por respuesta, en milisegundos.
AI_TIMEOUT_MS=20000
