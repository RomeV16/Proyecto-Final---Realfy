// ─── Importación desde el sistema anterior ──────────────

enum ImportBatchStatus {
  Validando
  Validado
  Ejecutando
  Completado
  Fallido
}

enum ImportEntity {
  Persona
  Propiedad
  Contrato
  Servicio
  ReglaDeCargo
}

enum ImportRowAction {
  Creado
  Actualizado
  SinCambios
  Error
}

/// Una corrida del importador (o su ensayo). El registro por fila queda en ImportRowLog.
model ImportBatch {
  id          String            @id @default(uuid())
  tenantId    String
  kind        String            @default("SistemaAnterior")
  status      ImportBatchStatus
  dryRun      Boolean
  atomic      Boolean           @default(false)
  createdById String?
  /// Totales por entidad y acción: { total, errors, byEntity: { Persona: { Creado, ... } } }.
  counts      Json?
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("ImportBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  rows      ImportRowLog[]

  @@index([tenantId, startedAt])
  @@map("import_batches")
}

/// Qué pasó con cada fila de un lote: creada, actualizada, sin cambios o con error.
model ImportRowLog {
  id          String          @id @default(uuid())
  tenantId    String
  batchId     String
  entity      ImportEntity
  externalRef String?
  rowNumber   Int
  action      ImportRowAction
  entityId    String?
  errors      Json?
  createdAt   DateTime        @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch  ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([batchId, action])
  @@map("import_row_logs")
}

// ─── Depósitos y liquidación de egreso ──────────────────

enum DepositHolder {
  Locador
  Inmobiliaria
}

/// Cómo se devuelve el depósito: en pesos actualizados al último alquiler o en la misma moneda.
enum DepositRefundRule {
  PesosActualizado
  MismaMoneda
}

enum DepositStatus {
  Pendiente
  Parcial
  Cobrado
  Devuelto
}

enum MoveOutStatus {
  Borrador
  Confirmada
}

/// Depósito en garantía de un contrato (D9). Reemplaza a `Contract.depositAmount`
/// y `depositCurrency`, que quedan sin uso (se migraron acá).
model ContractDeposit {
  id                 String            @id @default(uuid())
  tenantId           String
  contractId         String            @unique
  amount             Decimal           @db.Decimal(15, 2)
  currency           Currency
  heldBy             DepositHolder
  /// Locador dueño del dinero cuando lo guarda la inmobiliaria en custodia, o locador que lo guarda.
  heldByPersonId     String?
  installments       Int               @default(1)
  refundRule         DepositRefundRule
  refundInstallments Int               @default(1)
  /// Días corridos desde el egreso para devolver el depósito.
  refundDueDays      Int               @default(30)
  status             DepositStatus     @default(Pendiente)
  refundedAt         DateTime?         @db.Date
  refundedAmount     Decimal?          @db.Decimal(15, 2)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  contract        Contract                     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  heldByPerson    Person?                      @relation("DepositHolder", fields: [heldByPersonId], references: [id], onDelete: Restrict)
  installmentRows ContractDepositInstallment[]

  @@index([tenantId, status])
  @@map("contract_deposits")
}

/// Cuota del depósito. `paidAt` vacío: pendiente de cobro.
model ContractDepositInstallment {
  id             String    @id @default(uuid())
  tenantId       String
  depositId      String
  number         Int
  dueDate        DateTime  @db.Date
  amount         Decimal   @db.Decimal(15, 2)
  paidAt         DateTime? @db.Date
  /// Movimiento de caja del cobro (vacío si lo cobró el locador directamente).
  cashMovementId String?
  createdAt      DateTime  @default(now())

  deposit ContractDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@unique([depositId, number])
  @@index([tenantId])
  @@map("contract_deposit_installments")
}

/// Liquidación de egreso ("chequeo"): lo que el inquilino debe al irse contra el depósito.
/// `items` es la lista de renglones (ver `MoveOutItem` en @realfy/shared). Una por contrato.
model MoveOutSettlement {
  id               String        @id @default(uuid())
  tenantId         String
  contractId       String        @unique
  date             DateTime      @db.Date
  currency         Currency
  status           MoveOutStatus @default(Borrador)
  items            Json
  totalOwed        Decimal       @db.Decimal(15, 2)
  depositAvailable Decimal       @db.Decimal(15, 2)
  /// Positivo: se devuelve al inquilino. Negativo: lo que el inquilino todavía debe.
  netAmount        Decimal       @db.Decimal(15, 2)
  rate             Decimal?      @db.Decimal(18, 6)
  notes            String?
  cashMovementId   String?
  confirmedAt      DateTime?
  confirmedById    String?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("move_out_settlements")
}

// ─── Facturación por cuenta del locador ─────────────────

enum LessorInvoiceSource {
  Payment
  OwnerStatement
}

enum LessorInvoiceKind {
  Factura
  NotaCredito
}

enum LessorInvoiceStatus {
  Pendiente
  Emitido
  Fallido
  /// No había nada para facturar (sin importe en el alcance o sin factura que anular).
  Omitido
}

/// Factura (o nota de crédito) por emitir o ya emitida a nombre de un locador por un cobro o un
/// estado de cuenta. Una por origen, locador y tipo: es la cola de emisión (un fallo de ARCA no
/// rompe el cobro) y la garantía de que no se factura dos veces.
model LessorInvoiceJob {
  id            String              @id @default(uuid())
  tenantId      String
  personId      String
  sourceType    LessorInvoiceSource
  sourceId      String
  kind          LessorInvoiceKind
  status        LessorInvoiceStatus @default(Pendiente)
  /// Creado por la configuración del locador (automático) o por una persona.
  auto          Boolean             @default(false)
  comprobanteId String?
  attempts      Int                 @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  person      Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sourceType, sourceId, personId, kind])
  @@index([tenantId, status])
  @@index([tenantId, personId])
  @@map("lessor_invoice_jobs")
}

// ─── Mensajería saliente (D13, ADR-0013) ────────────────
//
// Todo mensaje a una persona (mail o WhatsApp) se encola en `MessageOutbox`
// dentro de la transacción del negocio, con una clave de idempotencia. Un
// proceso programado lo despacha según el modo del ambiente
// (MESSAGING_MODE), el consentimiento y el horario permitido.

enum MessageChannel {
  Email
  WhatsApp
}

enum MessageStatus {
  Pending
  Sending
  Sent
  Delivered
  Read
  Failed
  Blocked
  Cancelled
}

enum ConsentStatus {
  OptIn
  OptOut
}

enum ConsentSource {
  Manual
  Inbound
  Complaint
}

/// Bandeja de salida: un mensaje por fila, despachado por el proceso programado.
model MessageOutbox {
  id              String         @id @default(uuid())
  tenantId        String
  channel         MessageChannel
  personId        String?
  /// Dirección normalizada: mail en minúsculas o teléfono en dígitos con código de país.
  to              String
  templateKey     String
  vars            Json           @default("{}")
  status          MessageStatus  @default(Pending)
  /// Por qué sigue pendiente o quedó bloqueado (MESSAGING_OFF, PROVIDER_NOT_CONFIGURED, QUIET_HOURS, NOT_IN_ALLOWLIST, OPTED_OUT, NO_OPT_IN).
  statusReason    String?
  providerMsgId   String?        @unique
  error           String?
  attempts        Int            @default(0)
  nextAttemptAt   DateTime?
  scheduledAt     DateTime       @default(now())
  sentAt          DateTime?
  deliveredAt     DateTime?
  relatedType     String?
  relatedId       String?
  idempotencyKey  String         @unique
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  person              Person?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  conversationMessage ConversationMessage?

  collectionActions CollectionAction[]

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, relatedType, relatedId])
  @@index([tenantId, personId])
  @@index([tenantId, createdAt])
  @@map("message_outbox")
}

/// Consentimiento por canal (Ley 25.326): historial, vale el último registro.
model ContactConsent {
  id               String         @id @default(uuid())
  tenantId         String
  personId         String?
  channel          MessageChannel
  /// Dirección a la que aplica (la baja de un número que no es de ninguna persona también se respeta).
  address          String?
  status           ConsentStatus
  source           ConsentSource
  note             String?
  recordedByUserId String?
  at               DateTime       @default(now())

  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([tenantId, personId, channel, at])
  @@index([tenantId, channel, address, at])
  @@map("contact_consents")
}

/// Mensaje entrante mínimo (WhatsApp), para la bandeja de consultas.
model InboundMessage {
  id            String         @id @default(uuid())
  tenantId      String
  channel       MessageChannel
  from          String
  personId      String?
  body          String?
  providerMsgId String         @unique
  receivedAt    DateTime
  createdAt     DateTime       @default(now())

  person              Person?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  conversationMessage ConversationMessage?

  @@index([tenantId, receivedAt])
  @@index([tenantId, channel, from])
  @@map("inbound_messages")
}

// ─── Ventas y llaves ────────────────────────────────────

/// Etapa de una operación de venta. La escritura queda como estado final y fecha.
enum SalesOperationStatus {
  Captacion
  Publicada
  Reservada
  SenaRecibida
  Boleto
  Escriturada
  Cancelada
}

enum SalesPartyRole {
  Comprador
  Vendedor
}

enum SalesDepositKind {
  Reserva
  Sena
}

enum SalesDepositHolder {
  Inmobiliaria
  Vendedor
  Escribano
}

enum SalesDepositStatus {
  Pendiente
  Recibida
  Devuelta
  Retenida
  Vencida
  Aplicada
}

enum KeyHolder {
  Oficina
  Propietario
  Inquilino
  Empleado
  Tercero
}

/// Operación de venta de una propiedad: de la captación a la escritura (solo se registra su fecha).
/// Una propiedad tiene a lo sumo una operación abierta (lo controla el servicio).
model SalesOperation {
  id            String               @id @default(uuid())
  tenantId      String
  propertyId    String
  status        SalesOperationStatus @default(Captacion)
  exclusive     Boolean              @default(false)
  /// Precio de publicación.
  price         Decimal?             @db.Decimal(15, 2)
  /// Precio pactado en la reserva, la seña o el boleto.
  agreedPrice   Decimal?             @db.Decimal(15, 2)
  currency      Currency             @default(USD)
  agentUserId   String?
  boletoDate    DateTime?            @db.Date
  escrituraDate DateTime?            @db.Date
  cancelReason  String?
  closedAt      DateTime?
  notes         String?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  agent    User?           @relation("SalesOperationAgent", fields: [agentUserId], references: [id], onDelete: SetNull)
  parties  SalesParty[]
  deposits SalesDeposit[]
  docs     SalesDocCheck[]
  fees     Fee[]

  @@index([tenantId, status])
  @@index([tenantId, propertyId])
  @@index([agentUserId])
  @@map("sales_operations")
}

/// Comprador o vendedor de la operación, con su parte del lado (los porcentajes de un lado suman 100).
model SalesParty {
  id        String         @id @default(uuid())
  tenantId  String
  salesOpId String
  role      SalesPartyRole
  personId  String
  sharePct  Decimal        @default(100) @db.Decimal(7, 4)
  createdAt DateTime       @default(now())

  salesOperation SalesOperation @relation(fields: [salesOpId], references: [id], onDelete: Cascade)
  person         Person         @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([salesOpId, role, personId])
  @@index([tenantId])
  @@index([personId])
  @@map("sales_parties")
}

/// Reserva (con vencimiento) o seña de una venta. El dinero que guarda la inmobiliaria pasa por la caja
/// (categoría Sena); devolverlo o retenerlo se registra a mano, nunca solo.
model SalesDeposit {
  id                   String             @id @default(uuid())
  tenantId             String
  salesOpId            String
  kind                 SalesDepositKind
  amount               Decimal            @db.Decimal(15, 2)
  currency             Currency
  holder               SalesDepositHolder
  holderPersonId       String?
  payerPersonId        String?
  status               SalesDepositStatus @default(Pendiente)
  expiresAt            DateTime?          @db.Date
  receivedAt           DateTime?          @db.Date
  receivedMovementId   String?
  resolvedAt           DateTime?          @db.Date
  resolvedAmount       Decimal?           @db.Decimal(15, 2)
  resolutionMovementId String?
  resolutionNote       String?
  notes                String?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  salesOperation SalesOperation @relation(fields: [salesOpId], references: [id], onDelete: Cascade)
  holderPerson   Person?        @relation("SalesDepositHolder", fields: [holderPersonId], references: [id], onDelete: SetNull)
  payerPerson    Person?        @relation("SalesDepositPayer", fields: [payerPersonId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
  @@index([salesOpId])
  @@index([holderPersonId])
  @@index([payerPersonId])
  @@map("sales_deposits")
}

/// Un renglón de la documentación del inmueble (informe de dominio, inhibición, libre deuda...).
model SalesDocCheck {
  id        String    @id @default(uuid())
  tenantId  String
  salesOpId String
  code      String
  required  Boolean   @default(true)
  done      Boolean   @default(false)
  doneAt    DateTime?
  doneById  String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  salesOperation SalesOperation @relation(fields: [salesOpId], references: [id], onDelete: Cascade)

  @@unique([salesOpId, code])
  @@index([tenantId])
  @@map("sales_doc_checks")
}

/// Juego de llaves de una propiedad: quién las tiene hoy y dónde se guardan en la oficina.
model KeySet {
  id             String    @id @default(uuid())
  tenantId       String
  propertyId     String
  label          String
  copies         Int       @default(1)
  holder         KeyHolder @default(Oficina)
  holderPersonId String?
  holderUserId   String?
  holderName     String?
  location       String?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  holderPerson Person?       @relation("KeySetHolder", fields: [holderPersonId], references: [id], onDelete: SetNull)
  holderUser   User?         @relation("KeySetHolderUser", fields: [holderUserId], references: [id], onDelete: SetNull)
  movements    KeyMovement[]

  @@index([tenantId, holder])
  @@index([tenantId, propertyId])
  @@index([holderPersonId])
  @@index([holderUserId])
  @@map("key_sets")
}

/// Salida de un juego de llaves (a quién, cuándo, para qué, cuándo deberían volver) y su devolución.
/// Mientras `returnedAt` es nulo, la salida sigue abierta.
model KeyMovement {
  id               String    @id @default(uuid())
  tenantId         String
  keySetId         String
  holder           KeyHolder
  holderPersonId   String?
  holderUserId     String?
  holderName       String?
  reason           String?
  outAt            DateTime  @db.Date
  expectedReturnAt DateTime? @db.Date
  returnedAt       DateTime? @db.Date
  outById          String?
  returnedById     String?
  notes            String?
  createdAt        DateTime  @default(now())

  keySet       KeySet  @relation(fields: [keySetId], references: [id], onDelete: Cascade)
  holderPerson Person? @relation("KeyMovementHolder", fields: [holderPersonId], references: [id], onDelete: SetNull)
  holderUser   User?   @relation("KeyMovementHolderUser", fields: [holderUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, returnedAt])
  @@index([keySetId, outAt])
  @@index([holderPersonId])
  @@index([holderUserId])
  @@map("key_movements")
}

// ─── Cobranza escalonada (ADR-0013) ─────────────────────

enum CollectionStage {
  Recordatorio
  Prejudicial
  Abogado
  Judicial
  Cerrado
}

enum CollectionActionKind {
  Recordatorio
  RecordatorioFirme
  CartaDocumento
  DerivacionAbogado
  Nota
  Pago
  Acuerdo
}

enum CollectionActionStatus {
  Preparada
  Realizada
}

/// Caso de cobranza: un contrato con alquileres vencidos impagos. Un caso abierto por contrato;
/// una mora nueva después de cerrarlo abre otro.
model CollectionCase {
  id               String                @id @default(uuid())
  tenantId         String
  contractId       String
  stage            CollectionStage       @default(Recordatorio)
  currency         Currency              @default(ARS)
  /// Vencimiento impago más viejo en la última pasada del proceso diario.
  overdueSince     DateTime
  /// Saldo vencido en la última pasada: un saldo menor indica un pago parcial.
  lastBalance      Decimal?              @db.Decimal(15, 2)
  nextActionKind   CollectionActionKind?
  nextActionAt     DateTime?
  /// Último día de un acuerdo de pago vigente.
  pausedUntil      DateTime?
  letterPreparedOn DateTime?
  /// Día en que se confirmó el envío en papel de la carta documento.
  letterSentOn     DateTime?
  assigneeId       String?
  closeReason      String?
  /// Día en que se abrió; con el contrato evita abrir dos casos el mismo día.
  openedOn         DateTime
  closedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  contract Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actions  CollectionAction[]

  @@unique([contractId, openedOn])
  @@index([tenantId, stage, nextActionAt])
  @@index([tenantId, contractId])
  @@map("collection_cases")
}

/// Línea de tiempo de un caso: avisos mandados, carta documento, acuerdos, pagos y notas.
model CollectionAction {
  id              String                 @id @default(uuid())
  tenantId        String
  caseId          String
  kind            CollectionActionKind
  status          CollectionActionStatus @default(Realizada)
  /// Nivel de tono del recordatorio (1 a 3).
  level           Int?
  channel         MessageChannel?
  outboxMessageId String?
  /// Importe a pagar ese día (recordatorio) o prometido (acuerdo).
  amount          Decimal?               @db.Decimal(15, 2)
  /// Fecha propia de la acción: promesa de pago del acuerdo o envío de la carta.
  onDate          DateTime?
  note            String?
  /// Campos editables de la carta documento y destinatario de un recordatorio.
  data            Json?
  /// Clave de la acción automática de un día (evita repetirla si el proceso corre dos veces).
  key             String?
  createdByUserId String?
  at              DateTime               @default(now())

  case   CollectionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  outbox MessageOutbox? @relation(fields: [outboxMessageId], references: [id], onDelete: SetNull)

  @@unique([caseId, key])
  @@index([tenantId, caseId, at])
  @@map("collection_actions")
}

/// Consulta de la bandeja unificada: un hilo con una persona por un canal (WhatsApp, mail,
/// formulario del micrositio o llamada), con responsable y plazo de primera respuesta.
model Conversation {
  id              String              @id @default(uuid())
  tenantId        String
  channel         ConversationChannel
  /// Dirección normalizada de quien escribe (teléfono, mail) o la que dejó en el formulario.
  address         String
  counterpartName String?
  subject         String?
  status          ConversationStatus  @default(Nueva)
  personId        String?
  leadId          String?
  /// Propiedad o contrato a los que se refiere: "Property" o "Contract".
  relatedType     String?
  relatedId       String?
  assigneeUserId  String?
  firstResponseAt DateTime?
  slaDueAt        DateTime?
  slaBreachedAt   DateTime?
  autoRepliedAt   DateTime?
  /// Mensajes del cliente que nadie abrió todavía.
  unread          Int                 @default(0)
  lastMessageAt   DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  person   Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)
  lead     Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignee User?                 @relation("ConversationAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, assigneeUserId, status])
  @@index([tenantId, channel, address, lastMessageAt])
  @@index([tenantId, slaDueAt])
  @@index([tenantId, personId])
  @@map("conversations")
}

/// Mensaje de una consulta. Los entrantes de WhatsApp y mail apuntan a su fila de
/// `inbound_messages`; los salientes, a su fila de `message_outbox` (de ahí sale el estado de entrega).
model ConversationMessage {
  id               String           @id @default(uuid())
  tenantId         String
  conversationId   String
  direction        MessageDirection
  body             String
  /// Adjuntos: referencias [{ name, url? }]; el contenido no se guarda en la base.
  attachments      Json             @default("[]")
  inboundMessageId String?          @unique
  outboxMessageId  String?          @unique
  authorUserId     String?
  isAutoReply      Boolean          @default(false)
  at               DateTime
  createdAt        DateTime         @default(now())

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inboundMessage InboundMessage? @relation(fields: [inboundMessageId], references: [id], onDelete: SetNull)
  outboxMessage  MessageOutbox?  @relation(fields: [outboxMessageId], references: [id], onDelete: SetNull)

  @@index([tenantId, conversationId, at])
  @@map("conversation_messages")
}
