generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelos se agregan progresivamente por feature

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  Admin
  Gerente
  Ventas
  Liquidaciones
  Marketing
  Soporte
  Lectura
}

enum TenantTier {
  Free
  Starter
  Professional
  Enterprise
}

enum Currency {
  ARS
  USD
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ─── Property Enums ─────────────────────────────────────

enum PropertyType {
  Departamento
  Casa
  PH
  Duplex
  Triplex
  Local
  Oficina
  Consultorio
  Galpon
  Deposito
  Terreno
  Lote
  Campo
  Cochera
  Quincho
  Hotel
  Fondo_de_comercio
  Edificio
  Otro
}

enum PropertyOperationType {
  Venta
  Alquiler
  Temporario
}

enum PropertyState {
  Borrador
  Disponible
  Reservado
  Alquilado
  Vendido
  Ocupado
  Suspendido
  Archivado
}

// ─── Person Enums ───────────────────────────────────────

enum PersonRole {
  Propietario
  Inquilino
  Garante
  Lead
  Comprador
  Proveedor
}

enum FiscalCondition {
  ResponsableInscripto
  Monotributista
  ConsumidorFinal
  Exento
  NoResponsable
}

// ─── Auth & Tenancy Models ──────────────────────────────

model Tenant {
  id             String     @id @default(uuid())
  name           String
  cuit           String
  province       String
  timezone       String     @default("America/Buenos_Aires")
  currency       Currency   @default(ARS)
  tier           TenantTier @default(Professional)
  brandPrimary   String?
  brandSecondary String?
  logoUrl        String?
  penaltyConfig  Json?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  users       User[]
  invitations UserInvitation[]
  auditLogs   AuditLog[]
  properties  Property[]
  persons     Person[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(Lectura)
  tenantId     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  invitations   UserInvitation[] @relation("InvitedByUser")
  auditLogs     AuditLog[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserInvitation {
  id              String    @id @default(uuid())
  email           String
  role            UserRole
  tenantId        String
  invitedByUserId String
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
  @@map("user_invitations")
}

// ─── Property Models ────────────────────────────────────

model Property {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        PropertyType

  // Address
  street      String?
  number      String?
  floor       String?
  apartment   String?
  city        String?
  province    String?
  zipCode     String?
  country     String       @default("Argentina")

  // Geolocation
  latitude    Float?
  longitude   Float?

  // Characteristics
  area        Float?
  rooms       Int?
  bedrooms    Int?
  bathrooms   Int?
  garages     Int?
  age         Int?
  orientation String?
  amenities   String[]

  // Pricing (default / display price)
  price       Decimal?     @db.Decimal(15, 2)
  currency    Currency     @default(ARS)

  isActive    Boolean      @default(true)
  tenantId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operations   PropertyOperation[]
  media        PropertyMedia[]
  priceHistory PriceHistory[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("properties")
}

model PropertyOperation {
  id            String                @id @default(uuid())
  propertyId    String
  operationType PropertyOperationType
  state         PropertyState         @default(Borrador)
  price         Decimal?              @db.Decimal(15, 2)
  currency      Currency              @default(ARS)
  tenantId      String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, operationType])
  @@index([tenantId])
  @@index([tenantId, state])
  @@map("property_operations")
}

model PropertyMedia {
  id           String  @id @default(uuid())
  propertyId   String
  url          String
  thumbnailUrl String?
  mimeType     String
  sizeBytes    Int?
  width        Int?
  height       Int?
  sortOrder    Int     @default(0)
  isPrimary    Boolean @default(false)
  tenantId     String
  createdAt    DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId, sortOrder])
  @@map("property_media")
}

model PriceHistory {
  id              String   @id @default(uuid())
  propertyId      String
  price           Decimal  @db.Decimal(15, 2)
  currency        Currency @default(ARS)
  changedAt       DateTime @default(now())
  changedByUserId String?
  tenantId        String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId, changedAt])
  @@map("price_history")
}

// ─── Person Models ──────────────────────────────────────

model Person {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  phone2          String?
  cuit            String?
  fiscalCondition FiscalCondition?
  bankName        String?
  cbu             String?
  bankAlias       String?
  notes           String?
  isActive        Boolean          @default(true)
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles           PersonRoleAssignment[]
  documents       PersonDocument[]
  providerProfile ProviderProfile?

  @@unique([tenantId, cuit])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, firstName, lastName])
  @@map("persons")
}

model ProviderProfile {
  id            String   @id @default(uuid())
  personId      String   @unique
  tenantId      String
  rubros        String[]
  coverageZones String[]
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("provider_profiles")
}

model PersonRoleAssignment {
  id         String     @id @default(uuid())
  personId   String
  role       PersonRole
  tenantId   String
  assignedAt DateTime   @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, role])
  @@index([tenantId])
  @@map("person_role_assignments")
}

model PersonDocument {
  id         String   @id @default(uuid())
  personId   String
  tenantId   String
  fileName   String
  url        String
  mimeType   String
  sizeBytes  Int?
  uploadedAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([personId])
  @@map("person_documents")
}
