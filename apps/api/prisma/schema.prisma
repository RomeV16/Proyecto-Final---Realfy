generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  Admin
  Gerente
  Ventas
  Liquidaciones
  Marketing
  Soporte
  Lectura
}

enum TenantTier {
  Free
  Starter
  Professional
  Enterprise
}

enum Currency {
  ARS
  USD
  EUR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ─── Property Enums ─────────────────────────────────────

enum PropertyType {
  Departamento
  Casa
  PH
  Duplex
  Triplex
  Local
  Oficina
  Consultorio
  Galpon
  Deposito
  Terreno
  Lote
  Campo
  Cochera
  Quincho
  Hotel
  Fondo_de_comercio
  Edificio
  Otro
}

enum PropertyOperationType {
  Venta
  Alquiler
  Temporario
}

/// Canal por el que llega una consulta a la bandeja.
enum ConversationChannel {
  WhatsApp
  Email
  Web
  Telefono
}

/// Estado de una consulta de la bandeja.
enum ConversationStatus {
  Nueva
  Asignada
  EnCurso
  Esperando
  Resuelta
  Archivada
}

/// Sentido de un mensaje de una consulta (In: del cliente; Out: de la inmobiliaria).
enum MessageDirection {
  In
  Out
}

/// Estado de un aviso en un portal (publicación).
enum ListingStatus {
  NoPublicado
  Publicado
  Pausado
  Vencido
}

enum PropertyState {
  Borrador
  Disponible
  Reservado
  Alquilado
  Vendido
  Ocupado
  Suspendido
  Archivado
}

// ─── Person Enums ───────────────────────────────────────

enum PersonRole {
  Propietario
  Inquilino
  Garante
  Lead
  Comprador
  Proveedor
  Apoderado
}

enum LessorCapacity {
  Propietario
  Usufructuario
  Sublocador
  Acreedor
  Otro
}

enum SignatureMode {
  Indistinta
  Conjunta
}

enum PersonType {
  Fisica
  Juridica
}

enum PayoutMethod {
  Transferencia
  Efectivo
  Custodia
}

enum FiscalCondition {
  ResponsableInscripto
  Monotributista
  ConsumidorFinal
  Exento
  NoResponsable
}

// ─── Pipeline Enums ─────────────────────────────────────

enum PipelineType {
  Alquiler
  Venta
}

// ─── Lead Enums ─────────────────────────────────────────

enum LeadSource {
  WebInquiry
  PhoneCall
  Email
  WalkIn
  Referral
  Portal
  SocialMedia
  Other
}

enum LeadStatus {
  Nuevo
  Contactado
  Calificado
  Convertido
  Perdido
}

// ─── Interaction & Visit Enums ──────────────────────────

enum InteractionType {
  Llamada
  Email
  WhatsApp
  Visita
  Nota
}

enum VisitStatus {
  Programada
  Completada
  Cancelada
  NoShow
}

enum VisitOutcome {
  Interesado
  NoInteresado
  Pendiente
  Oferta
}

// ─── Contract Enums ─────────────────────────────────────

enum ContractStatus {
  Borrador
  Activo
  Vencido
  Rescindido
  Renovado
  Archivado
}

enum ContractType {
  Alquiler
  AlquilerTemporario
  Venta
}

enum AdjustmentType {
  IPC
  ICL
  CCP
  FixedPercent
  Custom
  UVA
  Escalonado
}

enum AdjustmentPeriod {
  Mensual
  Bimestral
  Trimestral
  Cuatrimestral
  Semestral
  Anual
}

enum GuaranteeType {
  Seguro_de_caucion
  Garantia_propietaria
  Garantia_bancaria
  Deposito
  Otra
}

enum GuaranteeStatus {
  Vigente
  Vencida
  Cancelada
}

enum IndexType {
  IPC
  ICL
  CVS
  CER
  UVA
  TasaActivaBNA
}

enum ContractPeriodKind {
  Original
  Renovacion
  Prorroga
}

enum ContractAgreementKind {
  Renegociacion
  Rebaja
  Bonificacion
  CambioRegla
  CambioReparto
  CambioCargo
  /// Prórroga de palabra: mueve el fin real sin cambiar el fin pactado.
  Prorroga
  /// Renovación como período del mismo contrato.
  Renovacion
}

/// Qué se prepara cuando se acerca el fin de un contrato.
enum FollowUpKind {
  Devolucion
  Renovacion
}

enum FollowUpStatus {
  Abierto
  Cerrado
}

/// Cómo terminó el seguimiento.
enum FollowUpOutcome {
  Pendiente
  Renovado
  Devuelto
  Prorrogado
}

/// Sobre qué alquiler se aplica el ajuste: el original del período o el vigente.
enum AdjustmentBase {
  Original
  Vigente
}

/// Quién cobra el alquiler y quién rinde a quién.
enum PaymentFlow {
  Partido
  TodoInmobiliaria
  TodoLocador
}

enum ScheduleStatus {
  Pending
  Calculated
  Applied
  Skipped
}

// ─── Auth & Tenancy Models ──────────────────────────────

model Tenant {
  id                  String     @id @default(uuid())
  name                String
  slug                String?    @unique
  cuit                String
  province            String
  timezone            String     @default("America/Buenos_Aires")
  currency            Currency   @default(ARS)
  tier                TenantTier @default(Professional)
  brandPrimary        String?
  brandSecondary      String?
  logoUrl             String?
  penaltyConfig       Json?
  readPolicy          Json?
  /// Valores por defecto de la operación (null: rigen los del código). Ver OperationalDefaultsSchema.
  operationalDefaults Json?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  users               User[]
  invitations         UserInvitation[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  importBatches       ImportBatch[]
  importRowLogs       ImportRowLog[]
  properties          Property[]
  persons             Person[]
  pipelines           Pipeline[]

  ticketCategories TicketCategory[]
  tickets          Ticket[]

  arcaCertificate ArcaCertificate?
  arcaIssuers     ArcaIssuer[]
  libroIvaExports LibroIvaExport[]
  scoreConfigs    TenantScoreConfig[]
  scores          TenantScore[]

  reportSchedules ReportSchedule[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(Lectura)
  tenantId     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens       RefreshToken[]
  invitations         UserInvitation[]     @relation("InvitedByUser")
  passwordResetTokens PasswordResetToken[] @relation("PasswordResetUser")
  auditLogs           AuditLog[]
  importBatches       ImportBatch[]        @relation("ImportBatchCreator")
  notifications       Notification[]

  ticketsCreated    Ticket[]           @relation("TicketCreator")
  ticketsAssigned   Ticket[]           @relation("TicketAssignee")
  ticketComments    TicketComment[]    @relation("TicketCommentUser")
  portalInvitations PortalInvitation[] @relation("PortalInvitedByUser")

  assignedLeads      Lead[]
  interactionsLogged LeadInteraction[] @relation("InteractionUser")
  visitsConducted    LeadVisit[]       @relation("VisitUser")

  scoredTenantScores TenantScore[] @relation("ScoredByUser")
  paymentsReceived   Payment[]     @relation("PaymentReceivedBy")

  staffCommissions StaffCommission[] @relation("StaffCommissionUser")
  propertyListings PropertyListing[] @relation("ListingUpdatedBy")
  conversations    Conversation[]    @relation("ConversationAssignee")

  salesOperationsAgent SalesOperation[] @relation("SalesOperationAgent")
  keySetsHeld          KeySet[]         @relation("KeySetHolderUser")
  keyMovementsHeld     KeyMovement[]    @relation("KeyMovementHolderUser")

  @@unique([email, tenantId])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserInvitation {
  id              String    @id @default(uuid())
  email           String
  role            UserRole
  tenantId        String
  invitedByUserId String
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
  @@map("user_invitations")
}

/// Enlace de un solo uso para elegir una contraseña nueva. Solo se guarda el
/// hash SHA-256 del token; el valor en claro existe una vez, en la respuesta
/// al Admin o en el correo.
model PasswordResetToken {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Property Models ────────────────────────────────────

model Property {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        PropertyType

  // Address
  street    String?
  number    String?
  floor     String?
  apartment String?
  city      String?
  province  String?
  zipCode   String?
  country   String  @default("Argentina")

  // Geolocation
  latitude  Float?
  longitude Float?

  // Characteristics
  area        Float?
  rooms       Int?
  bedrooms    Int?
  bathrooms   Int?
  garages     Int?
  age         Int?
  orientation String?
  amenities   String[]

  // Pricing (default / display price)
  price    Decimal? @db.Decimal(15, 2)
  currency Currency @default(ARS)

  // Catastro y edificio (la unidad apunta al edificio que la contiene)
  cadastralId      String?
  parentPropertyId String?
  externalRef      String?

  isActive  Boolean  @default(true)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Property?              @relation("edificio", fields: [parentPropertyId], references: [id], onDelete: SetNull)
  units        Property[]             @relation("edificio")
  operations   PropertyOperation[]
  media        PropertyMedia[]
  priceHistory PriceHistory[]
  contracts    Contract[]
  personRoles  PersonRoleAssignment[]
  ownerships   PropertyOwnership[]
  powers       PowerOfAttorney[]
  services     Service[]
  leads        Lead[]
  leadVisits   LeadVisit[]
  listings     PropertyListing[]

  tickets        Ticket[]
  valuations     PropertyValuation[]
  pendingCharges PendingCharge[]
  ownerLedger    OwnerLedgerEntry[]

  fees Fee[]

  salesOperations SalesOperation[]
  keySets         KeySet[]

  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@index([parentPropertyId])
  @@map("properties")
}

model PropertyOperation {
  id            String                @id @default(uuid())
  propertyId    String
  operationType PropertyOperationType
  state         PropertyState         @default(Borrador)
  price         Decimal?              @db.Decimal(15, 2)
  currency      Currency              @default(ARS)
  tenantId      String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, operationType])
  @@index([tenantId])
  @@index([tenantId, state])
  @@map("property_operations")
}

/// Aviso de una operación de una propiedad en un portal (Zonaprop, La Voz...) o en el
/// micrositio propio (portal "micrositio"). Una fila por propiedad + operación + portal.
model PropertyListing {
  id              String                @id @default(uuid())
  tenantId        String
  propertyId      String
  operationType   PropertyOperationType
  /// Clave del portal (ver Tenant.operationalDefaults.publication.portals) o "micrositio".
  portal          String
  status          ListingStatus         @default(NoPublicado)
  externalUrl     String?
  externalCode    String?
  publishedAt     DateTime?
  expiresAt       DateTime?
  updatedByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("ListingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([propertyId, operationType, portal])
  @@index([tenantId, status])
  @@index([tenantId, portal, status])
  @@index([tenantId, expiresAt])
  @@map("property_listings")
}

model PropertyMedia {
  id           String   @id @default(uuid())
  propertyId   String
  url          String
  thumbnailUrl String?
  mimeType     String
  sizeBytes    Int?
  width        Int?
  height       Int?
  sortOrder    Int      @default(0)
  isPrimary    Boolean  @default(false)
  tenantId     String
  createdAt    DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId, sortOrder])
  @@map("property_media")
}

model PriceHistory {
  id              String   @id @default(uuid())
  propertyId      String
  price           Decimal  @db.Decimal(15, 2)
  currency        Currency @default(ARS)
  changedAt       DateTime @default(now())
  changedByUserId String?
  tenantId        String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId, changedAt])
  @@map("price_history")
}

// ─── Person Models ──────────────────────────────────────

model Person {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  phone2          String?
  cuit            String?
  fiscalCondition FiscalCondition?
  personType      PersonType       @default(Fisica)
  dni             String?
  address         String?
  maritalStatus   String?
  nationality     String?
  payoutMethod    PayoutMethod?
  externalRef     String?
  /// @deprecated Reemplazada por PersonBankAccount; se elimina en la próxima versión.
  bankName        String?
  /// @deprecated Reemplazada por PersonBankAccount; se elimina en la próxima versión.
  cbu             String?
  /// @deprecated Reemplazada por PersonBankAccount; se elimina en la próxima versión.
  bankAlias       String?
  notes           String?
  isActive        Boolean          @default(true)
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles            PersonRoleAssignment[]
  bankAccounts     PersonBankAccount[]
  documents        PersonDocument[]
  contractPersons  ContractPerson[]
  lessorships      ContractLessor[]       @relation("LessorPerson")
  paidAsPayee      ContractLessor[]       @relation("LessorPayee")
  powersGranted    PowerOfAttorney[]      @relation("PowerPrincipal")
  powersHeld       PowerOfAttorney[]      @relation("PowerAgent")
  ownerships       PropertyOwnership[]
  providerProfile  ProviderProfile?
  leads            Lead[]
  rendiciones      OwnerRendicion[]
  delegatedIssuers ArcaIssuer[]           @relation("PersonDelegatedIssuer")
  invoiceJobs      LessorInvoiceJob[]

  assignedTickets        Ticket[]             @relation("TicketProvider")
  ticketsPreauthorized   Ticket[]             @relation("TicketPreauthorizer")
  ticketQuotes           TicketQuote[]        @relation("TicketQuoteProvider")
  ticketQuotesApproved   TicketQuote[]        @relation("TicketQuoteApprover")
  ticketsCreatedByPerson Ticket[]             @relation("TicketPortalCreator")
  ticketCommentsByPerson TicketComment[]      @relation("TicketCommentPerson")
  portalCredential       InquilinoCredential?
  portalRefreshTokens    PortalRefreshToken[]
  portalInvitations      PortalInvitation[]
  tenantScores           TenantScore[]
  pendingCharges         PendingCharge[]
  custodyAccounts        FinancialAccount[]   @relation("CustodyOwner")
  cashMovements          CashMovement[]       @relation("CashCounterparty")
  heldDeposits           ContractDeposit[]    @relation("DepositHolder")
  compensationsFrom      Compensation[]       @relation("CompensationFrom")
  compensationsTo        Compensation[]       @relation("CompensationTo")
  ownerLedger            OwnerLedgerEntry[]
  ownerStatements        OwnerStatement[]

  feesPaid         Fee[]             @relation("FeePayer")
  staffCommissions StaffCommission[] @relation("StaffCommissionPerson")

  outboxMessages  MessageOutbox[]
  contactConsents ContactConsent[]
  inboundMessages InboundMessage[]
  conversations   Conversation[]

  salesParties      SalesParty[]
  salesDepositsHeld SalesDeposit[] @relation("SalesDepositHolder")
  salesDepositsPaid SalesDeposit[] @relation("SalesDepositPayer")
  keySetsHeld       KeySet[]       @relation("KeySetHolder")
  keyMovementsHeld  KeyMovement[]  @relation("KeyMovementHolder")

  @@unique([tenantId, cuit])
  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, firstName, lastName])
  @@map("persons")
}

model PersonBankAccount {
  id        String   @id @default(uuid())
  tenantId  String
  personId  String
  currency  Currency
  bankName  String?
  cbu       String?
  alias     String?
  holder    String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person  Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  lessors ContractLessor[]

  @@index([tenantId])
  @@index([personId, currency])
  @@map("person_bank_accounts")
}

model ProviderProfile {
  id            String   @id @default(uuid())
  personId      String   @unique
  tenantId      String
  rubros        String[]
  coverageZones String[]
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("provider_profiles")
}

model PersonRoleAssignment {
  id                   String     @id @default(uuid())
  personId             String
  role                 PersonRole
  tenantId             String
  assignedAt           DateTime   @default(now())
  // optional link to property (for Propietario, Inquilino, Comprador, Garante)
  propertyId           String?
  // for Garante: which Propietario person they guarantee
  guarantorForPersonId String?

  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([personId, role])
  @@index([tenantId])
  @@map("person_role_assignments")
}

model PersonDocument {
  id         String   @id @default(uuid())
  personId   String
  tenantId   String
  fileName   String
  url        String
  mimeType   String
  sizeBytes  Int?
  uploadedAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([personId])
  @@map("person_documents")
}

// ─── Pipeline Models ────────────────────────────────────

model Pipeline {
  id        String       @id @default(uuid())
  tenantId  String
  type      PipelineType
  name      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  leads  Lead[]

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid())
  pipelineId String
  name       String
  sortOrder  Int
  staleDays  Int?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, sortOrder])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ─── Lead Models ────────────────────────────────────────

model Lead {
  id               String     @id @default(uuid())
  tenantId         String
  personId         String
  pipelineId       String
  currentStageId   String
  propertyId       String?
  assignedToUserId String?
  source           LeadSource
  status           LeadStatus @default(Nuevo)
  notes            String?
  budget           Decimal?   @db.Decimal(15, 2)
  budgetCurrency   Currency   @default(ARS)
  lostReason       String?
  convertedAt      DateTime?
  lostAt           DateTime?
  lastContactAt    DateTime?
  staleDays        Int?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  person         Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  pipeline       Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  currentStage   PipelineStage     @relation(fields: [currentStageId], references: [id], onDelete: Cascade)
  property       Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedToUser User?             @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  interactions   LeadInteraction[]
  visits         LeadVisit[]
  conversations  Conversation[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, pipelineId])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, source])
  @@index([tenantId, currentStageId])
  @@map("leads")
}

// ─── Interaction & Visit Models ─────────────────────────

model LeadInteraction {
  id          String          @id @default(uuid())
  tenantId    String
  leadId      String
  type        InteractionType
  notes       String?
  contactedBy String?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation("InteractionUser", fields: [contactedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, leadId])
  @@map("lead_interactions")
}

model LeadVisit {
  id          String        @id @default(uuid())
  tenantId    String
  leadId      String
  propertyId  String?
  scheduledAt DateTime
  completedAt DateTime?
  status      VisitStatus   @default(Programada)
  outcome     VisitOutcome?
  notes       String?
  conductedBy String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user     User?     @relation("VisitUser", fields: [conductedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, leadId])
  @@map("lead_visits")
}

// ─── Contract Models ────────────────────────────────────

model Contract {
  id                  String           @id @default(uuid())
  tenantId            String
  propertyId          String
  contractType        ContractType
  status              ContractStatus   @default(Borrador)
  startDate           DateTime
  endDate             DateTime
  rentAmount          Decimal          @db.Decimal(15, 2)
  rentCurrency        Currency         @default(ARS)
  depositAmount       Decimal?         @db.Decimal(15, 2)
  depositCurrency     Currency?
  adjustmentType      AdjustmentType
  adjustmentPeriod    AdjustmentPeriod
  customAdjustmentPct Decimal?         @db.Decimal(5, 2)
  notes               String?
  isActive            Boolean          @default(true)
  closedAt            DateTime?
  /// Fin real o prórroga de palabra. El fin efectivo es coalesce(actualEndDate, endDate).
  actualEndDate       DateTime?
  /// Contrato anterior de la cadena de renovaciones.
  previousContractId  String?
  externalRef         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  previousContract Contract?  @relation("ContractRenewal", fields: [previousContractId], references: [id], onDelete: SetNull)
  renewals         Contract[] @relation("ContractRenewal")

  property        Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  persons         ContractPerson[]
  lessors         ContractLessor[]
  powers          PowerOfAttorney[]
  guarantees      ContractGuarantee[]
  adjustments     ContractAdjustment[]
  schedules       AdjustmentSchedule[]
  liquidaciones   Liquidacion[]
  commission      ContractCommission?
  rendiciones     OwnerRendicion[]
  closureSummary  ContractClosureSummary?
  periods         ContractPeriod[]
  agreements      ContractAgreement[]
  chargeRules     ContractChargeRule[]
  billAllocations ServiceBillAllocation[]
  termsVersions   ContractTermsVersion[]
  pendingCharges  PendingCharge[]
  tickets         Ticket[]
  cashMovements   CashMovement[]
  ownerLedger     OwnerLedgerEntry[]

  followUps ContractFollowUp[]
  deposit   ContractDeposit?
  moveOut   MoveOutSettlement?

  collectionCases CollectionCase[]

  fees Fee[]

  @@unique([tenantId, externalRef])
  @@index([previousContractId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, propertyId])
  @@map("contracts")
}

model ContractPerson {
  id         String     @id @default(uuid())
  tenantId   String
  contractId String
  personId   String
  role       PersonRole

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([contractId, personId, role])
  @@index([tenantId])
  @@map("contract_persons")
}

/// Quien alquila en un contrato y cuánto del cobro le corresponde. No es la
/// titularidad de la propiedad: el porcentaje de cobro es un acuerdo del contrato.
model ContractLessor {
  id            String         @id @default(uuid())
  tenantId      String
  contractId    String
  personId      String
  capacity      LessorCapacity @default(Propietario)
  payoutPct     Decimal        @db.Decimal(7, 4)
  /// Apoderado que cobra en nombre del locador.
  payeePersonId String?
  bankAccountId String?
  validFrom     DateTime
  /// Fin exclusivo; null = sin fin.
  validTo       DateTime?
  /// Marca de datos migrados con reparto en partes iguales, a confirmar.
  needsReview   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  contract    Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  person      Person             @relation("LessorPerson", fields: [personId], references: [id], onDelete: Cascade)
  payee       Person?            @relation("LessorPayee", fields: [payeePersonId], references: [id], onDelete: SetNull)
  bankAccount PersonBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([contractId, validTo])
  @@index([tenantId, personId])
  @@map("contract_lessors")
}

/// Poder por el que `agent` actúa en nombre de `principal`. Sin contrato ni
/// propiedad es un poder general.
model PowerOfAttorney {
  id            String        @id @default(uuid())
  tenantId      String
  principalId   String
  agentId       String
  scopes        String[]
  signatureMode SignatureMode @default(Indistinta)
  /// Apoderados con la misma clave firman juntos (firma conjunta).
  groupKey      String?
  contractId    String?
  propertyId    String?
  validFrom     DateTime
  validTo       DateTime?
  documentUrl   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  principal Person    @relation("PowerPrincipal", fields: [principalId], references: [id], onDelete: Cascade)
  agent     Person    @relation("PowerAgent", fields: [agentId], references: [id], onDelete: Cascade)
  contract  Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId, principalId])
  @@index([tenantId, agentId])
  @@index([contractId])
  @@map("powers_of_attorney")
}

/// Quién es titular de una propiedad. Opcional y sin obligación de sumar 100.
model PropertyOwnership {
  id         String    @id @default(uuid())
  tenantId   String
  propertyId String
  personId   String
  sharePct   Decimal?  @db.Decimal(7, 4)
  title      String?
  since      DateTime?
  until      DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, propertyId])
  @@index([tenantId, personId])
  @@map("property_ownerships")
}

model ContractGuarantee {
  id           String          @id @default(uuid())
  tenantId     String
  contractId   String
  type         GuaranteeType
  status       GuaranteeStatus @default(Vigente)
  description  String?
  amount       Decimal?        @db.Decimal(15, 2)
  currency     Currency?
  issuer       String?
  policyNumber String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contract_guarantees")
}

model ContractAdjustment {
  id             String          @id @default(uuid())
  tenantId       String
  contractId     String
  periodNumber   Int
  adjustmentDate DateTime
  previousAmount Decimal         @db.Decimal(15, 2)
  newAmount      Decimal         @db.Decimal(15, 2)
  percentage     Decimal         @db.Decimal(8, 4)
  currency       Currency        @default(ARS)
  indexType      AdjustmentType?
  indexValues    Json?
  notes          String?
  calculatedAt   DateTime
  appliedAt      DateTime?
  /// Ajuste calculado con un índice estimado, a corregir cuando llegue el oficial.
  isProvisional  Boolean         @default(false)
  /// Ajuste provisional que este ajuste corrige.
  trueUpOfId     String?
  /// Cuándo se facturó la diferencia retroactiva de la corrección (nulo: pendiente).
  trueUpBilledAt DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, periodNumber, isProvisional])
  @@index([tenantId])
  @@index([contractId, periodNumber])
  @@map("contract_adjustments")
}

model AdjustmentSchedule {
  id                 String         @id @default(uuid())
  tenantId           String
  contractId         String
  nextAdjustmentDate DateTime
  periodNumber       Int
  status             ScheduleStatus @default(Pending)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, periodNumber])
  @@index([tenantId])
  @@map("adjustment_schedules")
}

/// Un tramo de vigencia del contrato: el original, una renovación o una prórroga.
model ContractPeriod {
  id                 String             @id @default(uuid())
  tenantId           String
  contractId         String
  seq                Int
  kind               ContractPeriodKind
  startDate          DateTime
  endDate            DateTime
  initialRent        Decimal            @db.Decimal(15, 2)
  signedAt           DateTime?
  /// Honorarios de la renovación pactados (el cobro va por la caja).
  feeAmount          Decimal?           @db.Decimal(15, 2)
  feeCurrency        Currency?
  /// Garantes que reafirmaron la garantía en la renovación.
  guarantorPersonIds String[]           @default([])
  createdAt          DateTime           @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  fees Fee[]

  @@unique([contractId, seq])
  @@index([tenantId])
  @@map("contract_periods")
}

/// Convenio fechado que cambia las reglas del contrato desde `effectiveFrom`.
model ContractAgreement {
  id            String                @id @default(uuid())
  tenantId      String
  contractId    String
  kind          ContractAgreementKind
  effectiveFrom DateTime
  effectiveTo   DateTime?
  documentUrl   String?
  notes         String?
  createdById   String?
  createdAt     DateTime              @default(now())

  contract    Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versions    ContractTermsVersion[]
  chargeRules ContractChargeRule[]

  @@index([tenantId])
  @@index([contractId, effectiveFrom])
  @@map("contract_agreements")
}

/// Foto de las reglas vigentes del contrato desde `validFrom`. Nunca se pisa:
/// un cambio crea una versión nueva.
model ContractTermsVersion {
  id                         String                 @id @default(uuid())
  tenantId                   String
  contractId                 String
  validFrom                  DateTime
  agreementId                String?
  adjustmentType             AdjustmentType
  adjustmentPeriod           AdjustmentPeriod
  adjustmentBase             AdjustmentBase         @default(Vigente)
  indexLagMonths             Int                    @default(2)
  fixedInitialMonths         Int                    @default(0)
  customPct                  Decimal?               @db.Decimal(5, 2)
  /// Escalonado: lista de { fromMonth, pct }.
  customSteps                Json?
  rentOverride               Decimal?               @db.Decimal(15, 2)
  discountPct                Decimal?               @db.Decimal(5, 2)
  discountAmount             Decimal?               @db.Decimal(15, 2)
  dueDay                     Int
  paymentFlow                PaymentFlow            @default(Partido)
  penaltyConfig              Json?
  /// Convenciones de liquidación; el valor por defecto de la columna es el comportamiento original.
  prorationMode              ProrationMode          @default(DiasReales)
  midMonthAdjustmentMode     MidMonthAdjustmentMode @default(DesdePeriodoSiguiente)
  firstDueMode               FirstDueMode           @default(DiaDeInicio)
  fixedDiscountProration     FixedDiscountProration @default(Proporcional)
  /// Umbral de anticipo del centro de carga, en comisiones mensuales; null = el de la inmobiliaria.
  upfrontThresholdFees       Int?
  /// Sobre qué comisión mensual se mide el umbral de anticipo.
  upfrontBasis               UpfrontBasis           @default(ComisionPactada)
  /// Qué le debe el locador que cobró directamente; null = el de la inmobiliaria.
  lessorDirectOwes           LessorDirectOwes?
  /// Límite de reparaciones sin consultar al locador (importe y moneda); null = el de la inmobiliaria.
  repairPreauthLimitAmount   Decimal?               @db.Decimal(15, 2)
  repairPreauthLimitCurrency Currency?
  createdAt                  DateTime               @default(now())

  contract  Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  agreement ContractAgreement? @relation(fields: [agreementId], references: [id])

  @@unique([contractId, validFrom])
  @@index([tenantId])
  @@index([agreementId])
  @@map("contract_terms_versions")
}

/// Seguimiento del fin de un contrato (devolución o renovación) con su checklist.
/// El semáforo no se guarda: se calcula del fin efectivo.
model ContractFollowUp {
  id         String          @id @default(uuid())
  tenantId   String
  contractId String
  kind       FollowUpKind
  status     FollowUpStatus  @default(Abierto)
  /// Fin efectivo del contrato cuando se abrió el seguimiento.
  dueDate    DateTime        @db.Date
  assigneeId String?
  outcome    FollowUpOutcome @default(Pendiente)
  notes      String?
  closedAt   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  contract Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tasks    FollowUpTask[]

  @@unique([contractId, kind, dueDate])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@map("contract_follow_ups")
}

/// Un paso del checklist de un seguimiento.
model FollowUpTask {
  id         String    @id @default(uuid())
  tenantId   String
  followUpId String
  code       String
  label      String
  position   Int
  done       Boolean   @default(false)
  doneAt     DateTime?
  doneById   String?
  dueDate    DateTime? @db.Date
  createdAt  DateTime  @default(now())

  followUp ContractFollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@unique([followUpId, code])
  @@index([tenantId])
  @@map("follow_up_tasks")
}

model IndexData {
  id             String    @id @default(uuid())
  tenantId       String
  indexType      IndexType
  period         DateTime
  value          Decimal   @db.Decimal(12, 6)
  source         String?
  /// Valor estimado (por ejemplo del REM); el oficial lo reemplaza con la misma clave.
  isEstimate     Boolean   @default(false)
  estimateSource String?
  createdAt      DateTime  @default(now())

  @@unique([tenantId, indexType, period])
  @@index([tenantId])
  @@map("index_data")
}

// ─── Contract Template Models ───────────────────────────

model ContractTemplate {
  id           String       @id @default(uuid())
  tenantId     String
  name         String
  contractType ContractType
  body         String
  variables    String[]
  isDefault    Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, contractType])
  @@index([tenantId, isActive])
  @@map("contract_templates")
}

// ─── Contract Closure Summary ───────────────────────────

enum ClosureSummarySource {
  model
  rules
}

model ContractClosureSummary {
  id          String               @id @default(uuid())
  tenantId    String
  contractId  String               @unique
  summary     String
  highlights  String[]
  metrics     Json
  source      ClosureSummarySource
  model       String?
  generatedAt DateTime             @default(now())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, source])
  @@map("contract_closure_summaries")
}

// ─── Liquidacion Enums ──────────────────────────────────

enum LiquidacionStatus {
  Borrador
  Revision
  Aprobada
  Pendiente
  Enviada
  Pagada
  Vencida
  Anulada
}

enum PaymentMethod {
  Transferencia
  Efectivo
  MercadoPago
  Cheque
  /// Pago interno: el depósito del contrato aplicado a las deudas de la liquidación de egreso.
  AplicacionDeposito
}

enum LineItemType {
  Alquiler
  Ajuste
  Extra
  Descuento
  Multa
  Impuesto
  Servicio
  Cargo
  Honorario
  AjusteRetroactivo
}

/// A quién le corresponde el importe de un renglón de la liquidación.
enum LineBeneficiary {
  Locador
  Inmobiliaria
  Ente
}

/// Convenciones de liquidación pactables por contrato (ADR-0010).
enum ProrationMode {
  DiasReales
  Mes30
  SinProrrateo
}

enum MidMonthAdjustmentMode {
  DesdePeriodoSiguiente
  Prorrateado
  DesdeEsePeriodo
}

enum FirstDueMode {
  DiaDeInicio
  VencimientoMesSiguiente
  AlFirmar
}

enum FixedDiscountProration {
  Proporcional
  Completo
}

enum LiquidacionKind {
  Mensual
  PagoACuenta
  Egreso
}

// ─── Liquidacion Models ─────────────────────────────────

model Liquidacion {
  id            String            @id @default(uuid())
  tenantId      String
  contractId    String
  period        DateTime
  status        LiquidacionStatus @default(Borrador)
  dueDate       DateTime
  subtotal      Decimal           @db.Decimal(15, 2)
  total         Decimal           @db.Decimal(15, 2)
  currency      Currency          @default(ARS)
  notes         String?
  pdfUrl        String?
  sentAt        DateTime?
  paidAt        DateTime?
  kind          LiquidacionKind   @default(Mensual)
  /// El alquiler usó un ajuste provisional (índice estimado); se corrige después.
  isProvisional Boolean           @default(false)
  /// Número de recibo de la inmobiliaria; se asigna al aprobar.
  receiptSeq    Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  contract        Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lineItems       LiquidacionLineItem[]
  billAllocations ServiceBillAllocation[]
  payments        Payment[]

  penalties        Penalty[]       @relation("PenaltyLiquidacion")
  settledPenalties Penalty[]       @relation("PenaltySettledLiquidacion")
  pendingCharges   PendingCharge[]

  @@unique([contractId, period])
  @@unique([tenantId, receiptSeq])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, contractId, period])
  @@map("liquidaciones")
}

model LiquidacionLineItem {
  id             String          @id @default(uuid())
  tenantId       String
  liquidacionId  String
  type           LineItemType
  description    String
  amount         Decimal         @db.Decimal(15, 2)
  currency       Currency        @default(ARS)
  sortOrder      Int             @default(0)
  /// La comisión de la inmobiliaria se calcula solo sobre renglones comisionables.
  commissionable Boolean
  beneficiary    LineBeneficiary
  /// Origen del renglón (boleta, cargo, punitorio, ajuste) para no duplicarlo.
  sourceType     String?
  sourceId       String?
  createdAt      DateTime        @default(now())

  liquidacion Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([liquidacionId])
  @@index([tenantId, sourceType, sourceId])
  @@map("liquidacion_line_items")
}

/// Contador por inmobiliaria y serie (numeración de recibos).
model DocumentSequence {
  id       String @id @default(uuid())
  tenantId String
  series   String
  next     Int    @default(1)

  @@unique([tenantId, series])
  @@map("document_sequences")
}

model Payment {
  id               String          @id @default(uuid())
  tenantId         String
  liquidacionId    String
  amount           Decimal         @db.Decimal(15, 2)
  currency         Currency        @default(ARS)
  method           PaymentMethod
  reference        String?
  notes            String?
  paidAt           DateTime
  /// Quién recibió el dinero: la inmobiliaria (caja, banco o custodia) o el locador directamente.
  receivedBy       PaymentReceiver @default(Inmobiliaria)
  /// Cuenta de la inmobiliaria donde entró (vacía si lo recibió el locador).
  accountId        String?
  /// Persona del personal que lo recibió en la oficina.
  receivedByUserId String?
  /// La parte de los locadores quedó en custodia hasta entregarla.
  inCustody        Boolean         @default(false)
  receiptId        String?         @unique
  externalRef      String?
  /// Reparto del cobro (settlement-engine) al momento de registrarlo.
  settlement       Json?
  createdAt        DateTime        @default(now())

  liquidacion    Liquidacion       @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  receivedByUser User?             @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  receipt        Receipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  comprobantes   Comprobante[]
  compensations  Compensation[]

  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@index([liquidacionId])
  @@map("payments")
}

/// Recibo de un cobro, numerado por serie con DocumentSequence.
model Receipt {
  id        String   @id @default(uuid())
  tenantId  String
  series    String
  number    Int
  issuedAt  DateTime
  amount    Decimal  @db.Decimal(15, 2)
  currency  Currency
  createdAt DateTime @default(now())

  payment Payment?

  feeInstallment FeeInstallment?

  @@unique([tenantId, series, number])
  @@index([tenantId, issuedAt])
  @@map("receipts")
}

// ─── Caja y cobros ──────────────────────────────────────

enum FinancialAccountKind {
  Caja
  Banco
  Custodia
}

enum CashDirection {
  In
  Out
}

enum CashCategory {
  AlquilerCobrado
  PagoLocador
  PagoEnte
  PagoProveedor
  Honorario
  Gasto
  ComisionEmpleado
  Sena
  Custodia
  Deposito
  Compensacion
  Conversion
}

/// Quién recibió un cobro.
enum PaymentReceiver {
  Inmobiliaria
  Locador
}

/// Qué le debe el locador a la inmobiliaria cuando el inquilino le paga directamente.
enum LessorDirectOwes {
  TodoLoAjeno
  SoloInmobiliaria
}

/// Concepto de un asiento de la cuenta corriente del locador (ADR-0009).
enum OwnerLedgerEntryType {
  SaldoInicial
  Alquiler
  Punitorio
  ReintegroImpuesto
  Comision
  Honorario
  Cargo
  PagoEnte
  Transferencia
  EntregaEfectivo
  CobroDirecto
  Compensacion
  Custodia
  Ajuste
}

enum OwnerStatementStatus {
  Borrador
  Emitido
  Enviado
  Anulado
}

/// Asiento de la cuenta corriente de un locador. El importe lleva signo:
/// positivo, la inmobiliaria le debe; negativo, se le descuenta o ya lo recibió.
/// Cada asiento sale de un origen (`sourceType`/`sourceId`) y se escribe una sola
/// vez por persona y concepto. Un asiento con `statementId` está en un estado
/// emitido y no se toca hasta anularlo.
model OwnerLedgerEntry {
  id          String               @id @default(uuid())
  tenantId    String
  personId    String
  contractId  String?
  propertyId  String?
  date        DateTime             @db.Date
  /// Mes del estado de cuenta al que va (primer día del mes).
  period      DateTime             @db.Date
  type        OwnerLedgerEntryType
  amount      Decimal              @db.Decimal(15, 2)
  currency    Currency
  description String
  statementId String?
  sourceType  String
  sourceId    String
  createdById String?
  createdAt   DateTime             @default(now())

  person    Person          @relation(fields: [personId], references: [id], onDelete: Restrict)
  contract  Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  property  Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  statement OwnerStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sourceType, sourceId, personId, type])
  @@index([tenantId, personId, currency, date])
  @@index([tenantId, period])
  @@index([statementId])
  @@map("owner_ledger_entries")
}

/// Estado de cuenta mensual de un locador en una moneda: todas sus unidades,
/// con el saldo arrastrado del estado anterior.
model OwnerStatement {
  id          String               @id @default(uuid())
  tenantId    String
  personId    String
  /// Mes del estado (primer día del mes).
  period      DateTime             @db.Date
  currency    Currency
  status      OwnerStatementStatus @default(Borrador)
  opening     Decimal              @db.Decimal(15, 2)
  credits     Decimal              @db.Decimal(15, 2)
  debits      Decimal              @db.Decimal(15, 2)
  payouts     Decimal              @db.Decimal(15, 2)
  closing     Decimal              @db.Decimal(15, 2)
  pdfUrl      String?
  sentAt      DateTime?
  issuedAt    DateTime?
  annulledAt  DateTime?
  annulReason String?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  person       Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  entries      OwnerLedgerEntry[]
  comprobantes Comprobante[]

  @@unique([tenantId, personId, period, currency])
  @@index([tenantId, period])
  @@index([tenantId, status])
  @@map("owner_statements")
}

/// Cuenta de la inmobiliaria: caja (efectivo), banco o custodia de un locador.
/// Una cuenta tiene una sola moneda; no hay conversión implícita.
model FinancialAccount {
  id            String               @id @default(uuid())
  tenantId      String
  kind          FinancialAccountKind
  name          String
  currency      Currency
  /// Locador dueño del dinero en custodia (solo kind = Custodia).
  ownerPersonId String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  owner     Person?        @relation("CustodyOwner", fields: [ownerPersonId], references: [id], onDelete: Restrict)
  movements CashMovement[]
  payments  Payment[]

  @@unique([tenantId, kind, ownerPersonId, currency])
  @@index([tenantId, kind, currency])
  @@map("financial_accounts")
}

/// Libro de la inmobiliaria: cada entrada o salida de dinero de una cuenta.
/// `amount` es siempre positivo; el sentido lo da `direction`.
model CashMovement {
  id             String        @id @default(uuid())
  tenantId       String
  accountId      String
  date           DateTime      @db.Date
  direction      CashDirection
  amount         Decimal       @db.Decimal(15, 2)
  currency       Currency
  category       CashCategory
  counterpartyId String?
  contractId     String?
  /// Tipo de cambio explícito de una conversión (moneda destino por unidad de origen).
  rate           Decimal?      @db.Decimal(18, 6)
  sourceType     String?
  sourceId       String?
  note           String?
  createdById    String?
  createdAt      DateTime      @default(now())

  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  counterparty Person?          @relation("CashCounterparty", fields: [counterpartyId], references: [id], onDelete: SetNull)
  contract     Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([tenantId, accountId, date])
  @@index([tenantId, category, date])
  @@index([tenantId, sourceType, sourceId])
  @@index([contractId])
  @@map("cash_movements")
}

/// Compensación entre locadores: `fromLessor` recibió (o cubre con su saldo)
/// dinero de un cobro que le corresponde a `toLessor`.
model Compensation {
  id           String   @id @default(uuid())
  tenantId     String
  paymentId    String
  fromLessorId String
  toLessorId   String
  amount       Decimal  @db.Decimal(15, 2)
  currency     Currency
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fromLessor Person  @relation("CompensationFrom", fields: [fromLessorId], references: [id], onDelete: Restrict)
  toLessor   Person  @relation("CompensationTo", fields: [toLessorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([paymentId])
  @@map("compensations")
}

// ─── Honorarios (D10) ───────────────────────────────────

/// Operación por la que se cobra un honorario.
enum FeeKind {
  AltaAlquiler
  Renovacion
  Venta
  Tasacion
  GestionReparacion
}

/// Sobre qué se calcula el honorario.
enum FeeBasis {
  TotalContrato
  ValorOperacion
  MontoFijo
}

/// Quién paga el honorario.
enum FeePayerRole {
  Inquilino
  Locador
  Comprador
  Vendedor
  Otro
}

enum FeeStatus {
  Pendiente
  Parcial
  Pagado
  SinCargo
  Anulado
}

enum FeeInstallmentStatus {
  Pendiente
  Pagada
  Anulada
}

/// Cómo se cobró una cuota: a una cuenta de la inmobiliaria o descontada de la cuenta del locador.
enum FeeSettlement {
  Caja
  CuentaLocador
}

/// IVA del honorario.
enum FeeVatMode {
  NoAplica
  Incluido
  Adicional
}

/// Honorario de una operación a cargo de una persona. Cuando pagan dos (inquilino
/// y locador, o comprador y vendedor) hay un honorario por cada una, con el mismo
/// `groupId`. `netAmount` es el honorario sin IVA (lo que se reparte con el
/// coorretaje y el personal) y `total` lo que paga quien paga.
model Fee {
  id                 String       @id @default(uuid())
  tenantId           String
  groupId            String?
  kind               FeeKind
  status             FeeStatus    @default(Pendiente)
  contractId         String?
  contractPeriodId   String?
  propertyId         String?
  valuationId        String?
  salesOpId          String?
  payerPersonId      String
  payerRole          FeePayerRole
  basis              FeeBasis
  /// Porcentaje sobre la base; nulo en un monto fijo.
  pct                Decimal?     @db.Decimal(7, 4)
  baseAmount         Decimal      @db.Decimal(15, 2)
  vatMode            FeeVatMode   @default(NoAplica)
  vatPct             Decimal      @default(0) @db.Decimal(5, 2)
  netAmount          Decimal      @db.Decimal(15, 2)
  vatAmount          Decimal      @default(0) @db.Decimal(15, 2)
  total              Decimal      @db.Decimal(15, 2)
  currency           Currency
  installments       Int
  adjustInstallments Boolean      @default(false)
  notes              String?
  createdById        String?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  contract         Contract?          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  contractPeriod   ContractPeriod?    @relation(fields: [contractPeriodId], references: [id], onDelete: Restrict)
  property         Property?          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  valuation        PropertyValuation? @relation(fields: [valuationId], references: [id], onDelete: SetNull)
  salesOperation   SalesOperation?    @relation(fields: [salesOpId], references: [id], onDelete: Restrict)
  payer            Person             @relation("FeePayer", fields: [payerPersonId], references: [id], onDelete: Restrict)
  installmentRows  FeeInstallment[]
  staffCommissions StaffCommission[]
  shares           FeeShare[]

  @@index([tenantId, kind, status])
  @@index([tenantId, payerPersonId])
  @@index([contractId])
  @@index([contractPeriodId])
  @@index([propertyId])
  @@index([valuationId])
  @@index([salesOpId])
  @@index([groupId])
  @@map("fees")
}

/// Cuota de un honorario. `adjustedAmount` es el importe ajustado con el
/// alquiler que se cobró (las pendientes se calculan al leer).
model FeeInstallment {
  id             String               @id @default(uuid())
  tenantId       String
  feeId          String
  n              Int
  dueDate        DateTime             @db.Date
  amount         Decimal              @db.Decimal(15, 2)
  adjustedAmount Decimal?             @db.Decimal(15, 2)
  status         FeeInstallmentStatus @default(Pendiente)
  paidAt         DateTime?            @db.Date
  paidAmount     Decimal?             @db.Decimal(15, 2)
  settlement     FeeSettlement?
  receiptId      String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  fee          Fee           @relation(fields: [feeId], references: [id], onDelete: Cascade)
  receipt      Receipt?      @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  comprobantes Comprobante[]

  @@unique([feeId, n])
  @@index([tenantId, status, dueDate])
  @@map("fee_installments")
}

/// Comisión de una persona del personal sobre un honorario: un usuario del
/// sistema o una persona (vendedor externo). Se paga desde la caja.
model StaffCommission {
  id         String    @id @default(uuid())
  tenantId   String
  feeId      String
  userId     String?
  personId   String?
  pct        Decimal   @db.Decimal(7, 4)
  baseAmount Decimal   @db.Decimal(15, 2)
  amount     Decimal   @db.Decimal(15, 2)
  currency   Currency
  paidAt     DateTime? @db.Date
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  fee    Fee     @relation(fields: [feeId], references: [id], onDelete: Cascade)
  user   User?   @relation("StaffCommissionUser", fields: [userId], references: [id], onDelete: Restrict)
  person Person? @relation("StaffCommissionPerson", fields: [personId], references: [id], onDelete: Restrict)

  @@index([tenantId, paidAt])
  @@index([feeId])
  @@index([userId])
  @@index([personId])
  @@map("staff_commissions")
}

/// Coorretaje: parte del honorario (sin IVA) que corresponde a otra inmobiliaria.
model FeeShare {
  id           String   @id @default(uuid())
  tenantId     String
  feeId        String
  counterparty String
  pct          Decimal  @db.Decimal(7, 4)
  amount       Decimal  @db.Decimal(15, 2)
  currency     Currency
  notes        String?
  createdAt    DateTime @default(now())

  fee Fee @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([feeId])
  @@map("fee_shares")
}

// ─── Service Enums ──────────────────────────────────────

enum ServiceType {
  Electricidad
  Gas
  Agua
  Internet
  Expensas
  Municipal
  ImpuestoInmobiliario
  Otro
}

/// Cada cuánto llega la boleta de un servicio o impuesto.
enum BillingFrequency {
  Mensual
  Bimestral
  Trimestral
  Anual
}

/// Quién paga un impuesto o servicio según el contrato.
enum ChargePayer {
  Inquilino
  Inmobiliaria
  Propietario
}

/// Cómo se calcula la parte del inquilino.
enum ChargeSplitMode {
  Porcentaje
  Consumo
  Fijo
}

enum ServicePaymentPlan {
  Mensual
  Anual
}

/// Cómo se recupera del inquilino una boleta anual.
enum AnnualRecovery {
  Unico
  Prorrateado
}

enum ServiceBillStatus {
  Pendiente
  Pagada
  Anulada
}

/// A quién va el descuento por pago anual.
enum AnnualDiscountBeneficiary {
  Inquilino
  Locador
  Inmobiliaria
}

/// Qué se hace con las cuotas anuales que quedan al terminar el contrato.
enum RemainingInstallmentsOnEnd {
  CobrarEnLiquidacionFinal
  Descartar
}

/// Quién pagó la boleta al ente.
enum BillPaidBy {
  Inquilino
  Inmobiliaria
  Propietario
}

// ─── Service Models ─────────────────────────────────────

model Service {
  id               String           @id @default(uuid())
  tenantId         String
  /// Referencia del sistema anterior; el importador hace upsert por ella.
  externalRef      String?
  propertyId       String
  serviceType      ServiceType
  providerName     String?
  accountNumber    String?
  amount           Decimal          @db.Decimal(15, 2)
  currency         Currency         @default(ARS)
  dueDay           Int
  isActive         Boolean          @default(true)
  notes            String?
  billingFrequency BillingFrequency @default(Mensual)
  hasAnnualOption  Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  property Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments ServicePayment[]
  bills    ServiceBill[]
  rules    ContractChargeRule[]

  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@index([tenantId, propertyId])
  @@index([tenantId, isActive])
  @@map("services")
}

model ServicePayment {
  id          String   @id @default(uuid())
  tenantId    String
  serviceId   String
  amount      Decimal  @db.Decimal(15, 2)
  paymentDate DateTime
  period      DateTime
  notes       String?
  billId      String?
  createdAt   DateTime @default(now())

  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bill    ServiceBill? @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([serviceId])
  @@index([billId])
  @@map("service_payments")
}

/// Regla de traslado de un impuesto o servicio a un contrato, vigente entre
/// `validFrom` y `validTo`. Nunca se pisa: un cambio cierra la anterior y crea
/// una versión nueva (con el convenio que lo respalda, si hay).
model ContractChargeRule {
  id                         String                     @id @default(uuid())
  tenantId                   String
  contractId                 String
  serviceId                  String
  payer                      ChargePayer
  splitMode                  ChargeSplitMode            @default(Porcentaje)
  tenantSharePct             Decimal                    @default(100) @db.Decimal(5, 2)
  fixedAmount                Decimal?                   @db.Decimal(15, 2)
  paymentPlan                ServicePaymentPlan         @default(Mensual)
  annualRecovery             AnnualRecovery             @default(Prorrateado)
  /// Cuotas del recupero prorrateado de una boleta anual (1 a 12).
  annualInstallments         Int                        @default(12)
  /// A quién va el descuento por pago anual: el inquilino paga lo pagado; con
  /// otro beneficiario paga el importe sin descuento y la diferencia es suya.
  annualDiscountBeneficiary  AnnualDiscountBeneficiary  @default(Inquilino)
  /// Qué pasa con las cuotas que quedan al terminar el contrato.
  remainingInstallmentsOnEnd RemainingInstallmentsOnEnd @default(CobrarEnLiquidacionFinal)
  validFrom                  DateTime
  validTo                    DateTime?
  agreementId                String?
  notes                      String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  contract    Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service     Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  agreement   ContractAgreement?      @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  allocations ServiceBillAllocation[]

  @@unique([contractId, serviceId, validFrom])
  @@index([tenantId])
  @@index([serviceId, validFrom])
  @@map("contract_charge_rules")
}

/// Boleta de un servicio o impuesto de una propiedad. Entidad propia: no es un
/// `ServicePayment` (el pago registra lo que se pagó; la boleta, lo que se debe).
model ServiceBill {
  id               String            @id @default(uuid())
  tenantId         String
  serviceId        String
  /// Primer día del mes de la boleta.
  period           DateTime          @db.Date
  installmentLabel String
  amount           Decimal           @db.Decimal(15, 2)
  /// Importe sin el descuento por pago anual.
  nominalAmount    Decimal?          @db.Decimal(15, 2)
  currency         Currency          @default(ARS)
  dueDate          DateTime?         @db.Date
  consumption      Decimal?          @db.Decimal(15, 3)
  /// Consumo de cada unidad: lista de { propertyId, consumption }.
  unitConsumptions Json?
  status           ServiceBillStatus @default(Pendiente)
  paidBy           BillPaidBy?
  paidAt           DateTime?
  receiptUrl       String?
  notes            String?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  service     Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  allocations ServiceBillAllocation[]
  payments    ServicePayment[]

  @@unique([serviceId, period, installmentLabel])
  @@index([tenantId, period])
  @@map("service_bills")
}

/// Parte de una boleta que se cobra al inquilino de un contrato, en la
/// liquidación del mes `chargePeriod`. Se factura una sola vez.
model ServiceBillAllocation {
  id                 String                     @id @default(uuid())
  tenantId           String
  billId             String
  contractId         String
  ruleId             String?
  payer              ChargePayer
  amount             Decimal                    @db.Decimal(15, 2)
  basis              String
  /// Parte de `amount` que es la diferencia por el descuento anual.
  surplus            Decimal                    @default(0) @db.Decimal(15, 2)
  surplusBeneficiary AnnualDiscountBeneficiary?
  /// Primer día del mes de la liquidación en que se cobra.
  chargePeriod       DateTime                   @db.Date
  installmentNo      Int                        @default(1)
  installmentsTotal  Int                        @default(1)
  liquidacionId      String?
  billedAt           DateTime?
  createdAt          DateTime                   @default(now())

  bill        ServiceBill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  liquidacion Liquidacion?        @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)
  contract    Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  rule        ContractChargeRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([billId, contractId, chargePeriod])
  @@index([tenantId, contractId, billedAt, chargePeriod])
  @@map("service_bill_allocations")
}

/// Comisión mensual con la que se mide el umbral de anticipo.
enum UpfrontBasis {
  /// La comisión pactada en el contrato (o, sin ella, el porcentaje por defecto).
  ComisionPactada
  /// Siempre el porcentaje por defecto de la inmobiliaria sobre el alquiler.
  PorcentajePorDefecto
}

/// Quién soporta un cargo puntual cargado en el centro de carga.
enum ChargeTarget {
  Inquilino
  Locador
  Inmobiliaria
}

enum PendingChargeKind {
  Reparacion
  ExpensaExtra
  Devolucion
  HonorarioGestion
  AjusteRetroactivo
  Otro
}

enum PendingChargeStatus {
  Pendiente
  Imputado
  CobradoAnticipado
  Anulado
}

/// Gasto o cargo puntual del mes (reparación, expensa extraordinaria, devolución,
/// honorario por gestión) que se imputa una sola vez: al inquilino en su próxima
/// liquidación o al locador en su próximo estado. `amount` lleva signo: un
/// negativo es un crédito a favor de quien lo soporta.
model PendingCharge {
  id                   String              @id @default(uuid())
  tenantId             String
  propertyId           String
  contractId           String?
  chargedTo            ChargeTarget
  lessorPersonId       String?
  kind                 PendingChargeKind
  description          String
  amount               Decimal             @db.Decimal(15, 2)
  currency             Currency            @default(ARS)
  /// A quién llega el dinero: quien pagó al proveedor (locador o inmobiliaria).
  beneficiary          LineBeneficiary     @default(Locador)
  incurredAt           DateTime            @db.Date
  /// Primer día del mes desde el cual se imputa; sin fecha, en la próxima liquidación.
  targetPeriod         DateTime?           @db.Date
  status               PendingChargeStatus @default(Pendiente)
  /// El importe supera el umbral de anticipo: no se imputa solo.
  requiresUpfront      Boolean             @default(false)
  installmentNo        Int                 @default(1)
  installmentOf        Int                 @default(1)
  /// Las cuotas de un mismo cargo comparten el grupo.
  installmentGroupId   String?
  imputedLiquidacionId String?
  /// Estado del locador en que se descontó (lo completa el estado de cuenta del locador).
  imputedStatementId   String?
  imputedAt            DateTime?
  sourceType           String?
  sourceId             String?
  notes                String?
  createdById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contract    Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  lessor      Person?      @relation(fields: [lessorPersonId], references: [id], onDelete: SetNull)
  liquidacion Liquidacion? @relation(fields: [imputedLiquidacionId], references: [id], onDelete: SetNull)

  @@index([tenantId, contractId, status])
  @@index([tenantId, propertyId, status])
  @@index([imputedLiquidacionId])
  @@map("pending_charges")
}

enum PenaltyStatus {
  active
  waived
}

model Penalty {
  id                   String        @id @default(uuid())
  tenantId             String
  liquidacionId        String
  amount               Decimal       @db.Decimal(14, 2)
  appliedOn            DateTime
  daysOverdue          Int
  compoundBase         Decimal?      @db.Decimal(14, 2)
  status               PenaltyStatus @default(active)
  waivedAt             DateTime?
  waivedBy             String? // userId
  waiveReason          String?
  settledLiquidacionId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  liquidacion        Liquidacion  @relation("PenaltyLiquidacion", fields: [liquidacionId], references: [id], onDelete: Cascade)
  settledLiquidacion Liquidacion? @relation("PenaltySettledLiquidacion", fields: [settledLiquidacionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([liquidacionId])
  @@index([settledLiquidacionId])
  @@map("penalties")
}

enum NotificationType {
  ServiceDueReminder
  ContractExpiring
  LiquidacionOverdue
  PaymentReceived
  SystemAlert
  StaleLeadAlert
  TicketCreated
  TicketStatusChanged
  TicketCommentAdded
  FiscalCertExpiry
  FiscalDelegationRevoked
  LibroIvaGenerated
  MessageFailed
  ContactOptedOut
  InboundMessageReceived
  InboxSlaBreached
  InboxAssigned
}

model EmailTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  subject   String
  body      String
  variables String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("email_templates")
}

model Notification {
  id         String           @id @default(uuid())
  tenantId   String
  userId     String
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId, isRead])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

// ─── Commission & Rendicion Enums ───────────────────────

enum CommissionType {
  FixedPercent
  FixedAmount
  Mixed
}

enum RendicionStatus {
  Borrador
  Aprobada
  Enviada
  Depositada
}

enum RendicionLineItemType {
  Alquiler
  Comision
  AdminFee
  Deduccion
  Ajuste
}

// ─── Commission & Rendicion Models ──────────────────────

model ContractCommission {
  id               String         @id @default(uuid())
  tenantId         String
  contractId       String         @unique
  type             CommissionType
  percentage       Decimal?       @db.Decimal(5, 2)
  fixedAmount      Decimal?       @db.Decimal(15, 2)
  adminFee         Decimal?       @db.Decimal(15, 2)
  currency         Currency       @default(ARS)
  /// Honorario por gestión de una reparación a cargo del locador, en % de su importe; null = sin honorario.
  repairMgmtFeePct Decimal?       @db.Decimal(5, 2)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contract_commissions")
}

model OwnerRendicion {
  id               String          @id @default(uuid())
  tenantId         String
  contractId       String
  ownerId          String
  period           DateTime
  status           RendicionStatus @default(Borrador)
  rentCollected    Decimal         @db.Decimal(15, 2)
  commissionAmount Decimal         @db.Decimal(15, 2)
  adminFeeAmount   Decimal         @db.Decimal(15, 2)
  deductionTotal   Decimal         @db.Decimal(15, 2)
  netDeposit       Decimal         @db.Decimal(15, 2)
  currency         Currency        @default(ARS)
  pdfUrl           String?
  sentAt           DateTime?
  depositedAt      DateTime?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  contract  Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  owner     Person              @relation(fields: [ownerId], references: [id])
  lineItems RendicionLineItem[]

  @@unique([contractId, period, ownerId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@map("owner_rendiciones")
}

model RendicionLineItem {
  id          String                @id @default(uuid())
  tenantId    String
  rendicionId String
  type        RendicionLineItemType
  description String
  amount      Decimal               @db.Decimal(15, 2)
  isDebit     Boolean               @default(false)
  currency    Currency              @default(ARS)
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())

  rendicion OwnerRendicion @relation(fields: [rendicionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([rendicionId])
  @@map("rendicion_line_items")
}

enum TicketStatus {
  Abierto
  Asignado
  EnProgreso
  ProveedorAsignado
  ProveedorEnCamino
  TrabajoRealizado
  Resuelto
  Cerrado
  Cancelado
  Reabierto
  /// El costo estimado supera el límite sin preautorización: espera al locador.
  PendienteAutorizacion
  /// Autorizado a presupuestar, con presupuestos en gestión.
  Presupuestado
  /// El locador aprobó un presupuesto; falta ejecutar el trabajo.
  PresupuestoAprobado
}

enum TicketQuoteStatus {
  Pendiente
  Aprobado
  Rechazado
}

/// Por dónde se registró una aprobación (de un presupuesto o la preautorización).
enum ApprovalChannel {
  WhatsApp
  Telefono
  Mail
  Presencial
}

enum TicketPriority {
  Urgente
  Alta
  Media
  Baja
}

// ─── Ticket Models ──────────────────────────────────────

model TicketCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  icon      String?
  color     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("ticket_categories")
}

model Ticket {
  id                      String           @id @default(uuid())
  tenantId                String
  propertyId              String
  /// Contrato vigente al que se imputa el gasto (el de la propiedad si hay uno solo).
  contractId              String?
  categoryId              String?
  createdByUserId         String?
  createdByPersonId       String?
  assignedToUserId        String?
  providerId              String?
  title                   String
  description             String?
  status                  TicketStatus     @default(Abierto)
  priority                TicketPriority   @default(Media)
  slaDeadline             DateTime?
  /// Costo estimado con el que se decide si hace falta preautorización.
  estimatedAmount         Decimal?         @db.Decimal(15, 2)
  costAmount              Decimal?         @db.Decimal(15, 2)
  costCurrency            Currency?
  /// Quién soporta el costo; se confirma al imputar (ChargeTarget del centro de carga).
  costPayer               ChargeTarget?
  providerNotes           String?
  /// Tope autorizado por el locador para actuar sin volver a consultarlo.
  preauthorizedAmount     Decimal?         @db.Decimal(15, 2)
  preauthorizedByPersonId String?
  preauthorizedAt         DateTime?
  preauthorizedChannel    ApprovalChannel?
  /// Se imputó a quien paga: una sola vez (el cargo es el de sourceType 'Ticket').
  imputedAt               DateTime?
  resolvedAt              DateTime?
  closedAt                DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contract        Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  category        TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User?           @relation("TicketCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdByPerson Person?         @relation("TicketPortalCreator", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  assignedTo      User?           @relation("TicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  provider        Person?         @relation("TicketProvider", fields: [providerId], references: [id], onDelete: SetNull)
  preauthorizedBy Person?         @relation("TicketPreauthorizer", fields: [preauthorizedByPersonId], references: [id], onDelete: SetNull)
  comments        TicketComment[]
  quotes          TicketQuote[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, propertyId])
  @@index([tenantId, contractId])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, createdByPersonId])
  @@index([tenantId, providerId])
  @@map("tickets")
}

/// Presupuesto de un proveedor para una incidencia. Se aprueba uno: lo aprueba el
/// locador (o quien lo representa) y se anota quién, cuándo y por qué canal.
model TicketQuote {
  id                 String            @id @default(uuid())
  tenantId           String
  ticketId           String
  providerId         String
  amount             Decimal           @db.Decimal(15, 2)
  currency           Currency          @default(ARS)
  status             TicketQuoteStatus @default(Pendiente)
  approvedByPersonId String?
  approvedByUserId   String?
  approvedAt         DateTime?
  channel            ApprovalChannel?
  documentUrl        String?
  notes              String?
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  ticket     Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  provider   Person  @relation("TicketQuoteProvider", fields: [providerId], references: [id], onDelete: Restrict)
  approvedBy Person? @relation("TicketQuoteApprover", fields: [approvedByPersonId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId])
  @@index([providerId])
  @@index([approvedByPersonId])
  @@map("ticket_quotes")
}

model TicketComment {
  id        String   @id @default(uuid())
  tenantId  String
  ticketId  String
  userId    String?
  personId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User?              @relation("TicketCommentUser", fields: [userId], references: [id], onDelete: Cascade)
  person      Person?            @relation("TicketCommentPerson", fields: [personId], references: [id], onDelete: SetNull)
  attachments TicketAttachment[]

  @@index([tenantId])
  @@index([ticketId])
  @@index([personId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  tenantId     String
  commentId    String
  url          String
  thumbnailUrl String?
  mimeType     String
  sizeBytes    Int?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())

  comment TicketComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([commentId])
  @@map("ticket_attachments")
}

