generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  Admin
  Gerente
  Ventas
  Liquidaciones
  Marketing
  Soporte
  Lectura
}

enum TenantTier {
  Free
  Starter
  Professional
  Enterprise
}

enum Currency {
  ARS
  USD
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ─── Property Enums ─────────────────────────────────────

enum PropertyType {
  Departamento
  Casa
  PH
  Duplex
  Triplex
  Local
  Oficina
  Consultorio
  Galpon
  Deposito
  Terreno
  Lote
  Campo
  Cochera
  Quincho
  Hotel
  Fondo_de_comercio
  Edificio
  Otro
}

enum PropertyOperationType {
  Venta
  Alquiler
  Temporario
}

enum PropertyState {
  Borrador
  Disponible
  Reservado
  Alquilado
  Vendido
  Ocupado
  Suspendido
  Archivado
}

// ─── Person Enums ───────────────────────────────────────

enum PersonRole {
  Propietario
  Inquilino
  Garante
  Lead
  Comprador
  Proveedor
}

enum FiscalCondition {
  ResponsableInscripto
  Monotributista
  ConsumidorFinal
  Exento
  NoResponsable
}

// ─── Pipeline Enums ─────────────────────────────────────

enum PipelineType {
  Alquiler
  Venta
}

// ─── Lead Enums ─────────────────────────────────────────

enum LeadSource {
  WebInquiry
  PhoneCall
  Email
  WalkIn
  Referral
  Portal
  SocialMedia
  Other
}

enum LeadStatus {
  Nuevo
  Contactado
  Calificado
  Convertido
  Perdido
}

// ─── Interaction & Visit Enums ──────────────────────────

enum InteractionType {
  Llamada
  Email
  WhatsApp
  Visita
  Nota
}

enum VisitStatus {
  Programada
  Completada
  Cancelada
  NoShow
}

enum VisitOutcome {
  Interesado
  NoInteresado
  Pendiente
  Oferta
}

// ─── Contract Enums ─────────────────────────────────────

enum ContractStatus {
  Borrador
  Activo
  Vencido
  Rescindido
  Renovado
  Archivado
}

enum ContractType {
  Alquiler
  AlquilerTemporario
  Venta
}

enum AdjustmentType {
  IPC
  ICL
  CCP
  FixedPercent
  Custom
}

enum AdjustmentPeriod {
  Mensual
  Bimestral
  Trimestral
  Cuatrimestral
  Semestral
  Anual
}

enum GuaranteeType {
  Seguro_de_caucion
  Garantia_propietaria
  Garantia_bancaria
  Deposito
  Otra
}

enum GuaranteeStatus {
  Vigente
  Vencida
  Cancelada
}

enum IndexType {
  IPC
  ICL
  CVS
  CER
  UVA
}

enum ScheduleStatus {
  Pending
  Calculated
  Applied
  Skipped
}

// ─── Auth & Tenancy Models ──────────────────────────────

model Tenant {
  id             String     @id @default(uuid())
  name           String
  slug           String?    @unique
  cuit           String
  province       String
  timezone       String     @default("America/Buenos_Aires")
  currency       Currency   @default(ARS)
  tier           TenantTier @default(Professional)
  brandPrimary   String?
  brandSecondary String?
  logoUrl        String?
  penaltyConfig  Json?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  users       User[]
  invitations UserInvitation[]
  auditLogs   AuditLog[]
  properties  Property[]
  persons     Person[]
  pipelines   Pipeline[]

  ticketCategories TicketCategory[]
  tickets          Ticket[]

  arcaCertificate ArcaCertificate?
  arcaIssuers     ArcaIssuer[]
  libroIvaExports LibroIvaExport[]
  scoreConfigs TenantScoreConfig[]
  scores       TenantScore[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(Lectura)
  tenantId     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  invitations   UserInvitation[] @relation("InvitedByUser")
  auditLogs     AuditLog[]
  notifications Notification[]

  ticketsCreated  Ticket[]        @relation("TicketCreator")
  ticketsAssigned Ticket[]        @relation("TicketAssignee")
  ticketComments  TicketComment[] @relation("TicketCommentUser")
  portalInvitations PortalInvitation[] @relation("PortalInvitedByUser")

  assignedLeads       Lead[]
  interactionsLogged  LeadInteraction[] @relation("InteractionUser")
  visitsConducted     LeadVisit[]       @relation("VisitUser")

  scoredTenantScores TenantScore[] @relation("ScoredByUser")

  @@unique([email, tenantId])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserInvitation {
  id              String    @id @default(uuid())
  email           String
  role            UserRole
  tenantId        String
  invitedByUserId String
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
  @@map("user_invitations")
}

// ─── Property Models ────────────────────────────────────

model Property {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        PropertyType

  // Address
  street      String?
  number      String?
  floor       String?
  apartment   String?
  city        String?
  province    String?
  zipCode     String?
  country     String       @default("Argentina")

  // Geolocation
  latitude    Float?
  longitude   Float?

  // Characteristics
  area        Float?
  rooms       Int?
  bedrooms    Int?
  bathrooms   Int?
  garages     Int?
  age         Int?
  orientation String?
  amenities   String[]

  // Pricing (default / display price)
  price       Decimal?     @db.Decimal(15, 2)
  currency    Currency     @default(ARS)

  isActive    Boolean      @default(true)
  tenantId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operations      PropertyOperation[]
  media           PropertyMedia[]
  priceHistory    PriceHistory[]
  contracts       Contract[]
  personRoles     PersonRoleAssignment[]
  services        Service[]
  leads           Lead[]
  leadVisits      LeadVisit[]

  tickets Ticket[]
  valuations PropertyValuation[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("properties")
}

model PropertyOperation {
  id            String                @id @default(uuid())
  propertyId    String
  operationType PropertyOperationType
  state         PropertyState         @default(Borrador)
  price         Decimal?              @db.Decimal(15, 2)
  currency      Currency              @default(ARS)
  tenantId      String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, operationType])
  @@index([tenantId])
  @@index([tenantId, state])
  @@map("property_operations")
}

model PropertyMedia {
  id           String  @id @default(uuid())
  propertyId   String
  url          String
  thumbnailUrl String?
  mimeType     String
  sizeBytes    Int?
  width        Int?
  height       Int?
  sortOrder    Int     @default(0)
  isPrimary    Boolean @default(false)
  tenantId     String
  createdAt    DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId, sortOrder])
  @@map("property_media")
}

model PriceHistory {
  id              String   @id @default(uuid())
  propertyId      String
  price           Decimal  @db.Decimal(15, 2)
  currency        Currency @default(ARS)
  changedAt       DateTime @default(now())
  changedByUserId String?
  tenantId        String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propertyId, changedAt])
  @@map("price_history")
}

// ─── Person Models ──────────────────────────────────────

model Person {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  phone2          String?
  cuit            String?
  fiscalCondition FiscalCondition?
  bankName        String?
  cbu             String?
  bankAlias       String?
  notes           String?
  isActive        Boolean          @default(true)
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles           PersonRoleAssignment[]
  documents       PersonDocument[]
  contractPersons ContractPerson[]
  providerProfile ProviderProfile?
  leads           Lead[]

  assignedTickets        Ticket[]        @relation("TicketProvider")
  ticketsCreatedByPerson Ticket[]        @relation("TicketPortalCreator")
  ticketCommentsByPerson TicketComment[] @relation("TicketCommentPerson")
  portalCredential     InquilinoCredential?
  portalRefreshTokens  PortalRefreshToken[]
  portalInvitations    PortalInvitation[]
  tenantScores           TenantScore[]

  @@unique([tenantId, cuit])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, firstName, lastName])
  @@map("persons")
}

model ProviderProfile {
  id            String   @id @default(uuid())
  personId      String   @unique
  tenantId      String
  rubros        String[]
  coverageZones String[]
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("provider_profiles")
}

model PersonRoleAssignment {
  id                   String     @id @default(uuid())
  personId             String
  role                 PersonRole
  tenantId             String
  assignedAt           DateTime   @default(now())
  // optional link to property (for Propietario, Inquilino, Comprador, Garante)
  propertyId           String?
  // for Garante: which Propietario person they guarantee
  guarantorForPersonId String?

  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([personId, role])
  @@index([tenantId])
  @@map("person_role_assignments")
}

model PersonDocument {
  id         String   @id @default(uuid())
  personId   String
  tenantId   String
  fileName   String
  url        String
  mimeType   String
  sizeBytes  Int?
  uploadedAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([personId])
  @@map("person_documents")
}

// ─── Pipeline Models ────────────────────────────────────

model Pipeline {
  id        String       @id @default(uuid())
  tenantId  String
  type      PipelineType
  name      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  leads  Lead[]

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid())
  pipelineId String
  name       String
  sortOrder  Int
  staleDays  Int?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, sortOrder])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

// ─── Lead Models ────────────────────────────────────────

model Lead {
  id               String       @id @default(uuid())
  tenantId         String
  personId         String
  pipelineId       String
  currentStageId   String
  propertyId       String?
  assignedToUserId String?
  source           LeadSource
  status           LeadStatus   @default(Nuevo)
  notes            String?
  budget           Decimal?     @db.Decimal(15, 2)
  budgetCurrency   Currency     @default(ARS)
  lostReason       String?
  convertedAt      DateTime?
  lostAt           DateTime?
  lastContactAt    DateTime?
  staleDays        Int?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  person         Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  pipeline       Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  currentStage   PipelineStage  @relation(fields: [currentStageId], references: [id], onDelete: Cascade)
  property       Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedToUser User?          @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  interactions   LeadInteraction[]
  visits         LeadVisit[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, pipelineId])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, source])
  @@index([tenantId, currentStageId])
  @@map("leads")
}

// ─── Interaction & Visit Models ─────────────────────────

model LeadInteraction {
  id          String          @id @default(uuid())
  tenantId    String
  leadId      String
  type        InteractionType
  notes       String?
  contactedBy String?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation("InteractionUser", fields: [contactedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, leadId])
  @@map("lead_interactions")
}

model LeadVisit {
  id          String        @id @default(uuid())
  tenantId    String
  leadId      String
  propertyId  String?
  scheduledAt DateTime
  completedAt DateTime?
  status      VisitStatus   @default(Programada)
  outcome     VisitOutcome?
  notes       String?
  conductedBy String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user     User?     @relation("VisitUser", fields: [conductedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, leadId])
  @@map("lead_visits")
}

// ─── Contract Models ────────────────────────────────────

model Contract {
  id                   String           @id @default(uuid())
  tenantId             String
  propertyId           String
  contractType         ContractType
  status               ContractStatus   @default(Borrador)
  startDate            DateTime
  endDate              DateTime
  rentAmount           Decimal          @db.Decimal(15, 2)
  rentCurrency         Currency         @default(ARS)
  depositAmount        Decimal?         @db.Decimal(15, 2)
  depositCurrency      Currency?
  adjustmentType       AdjustmentType
  adjustmentPeriod     AdjustmentPeriod
  customAdjustmentPct  Decimal?         @db.Decimal(5, 2)
  notes                String?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  property      Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  persons       ContractPerson[]
  guarantees    ContractGuarantee[]
  adjustments   ContractAdjustment[]
  schedules     AdjustmentSchedule[]
  liquidaciones Liquidacion[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, propertyId])
  @@map("contracts")
}

model ContractPerson {
  id         String     @id @default(uuid())
  tenantId   String
  contractId String
  personId   String
  role       PersonRole

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([contractId, personId, role])
  @@index([tenantId])
  @@map("contract_persons")
}

model ContractGuarantee {
  id           String          @id @default(uuid())
  tenantId     String
  contractId   String
  type         GuaranteeType
  status       GuaranteeStatus @default(Vigente)
  description  String?
  amount       Decimal?        @db.Decimal(15, 2)
  currency     Currency?
  issuer       String?
  policyNumber String?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contract_guarantees")
}

model ContractAdjustment {
  id             String          @id @default(uuid())
  tenantId       String
  contractId     String
  periodNumber   Int
  adjustmentDate DateTime
  previousAmount Decimal         @db.Decimal(15, 2)
  newAmount      Decimal         @db.Decimal(15, 2)
  percentage     Decimal         @db.Decimal(8, 4)
  currency       Currency        @default(ARS)
  indexType      AdjustmentType?
  indexValues    Json?
  notes          String?
  calculatedAt   DateTime
  appliedAt      DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId, periodNumber])
  @@map("contract_adjustments")
}

model AdjustmentSchedule {
  id                  String         @id @default(uuid())
  tenantId            String
  contractId          String
  nextAdjustmentDate  DateTime
  periodNumber        Int
  status              ScheduleStatus @default(Pending)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, periodNumber])
  @@index([tenantId])
  @@map("adjustment_schedules")
}

model IndexData {
  id        String    @id @default(uuid())
  tenantId  String
  indexType  IndexType
  period    DateTime
  value     Decimal   @db.Decimal(12, 6)
  source    String?
  createdAt DateTime  @default(now())

  @@unique([tenantId, indexType, period])
  @@index([tenantId])
  @@map("index_data")
}

// ─── Contract Template Models ───────────────────────────

model ContractTemplate {
  id           String       @id @default(uuid())
  tenantId     String
  name         String
  contractType ContractType
  body         String
  variables    String[]
  isDefault    Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, contractType])
  @@index([tenantId, isActive])
  @@map("contract_templates")
}

// ─── Liquidacion Enums ──────────────────────────────────

enum LiquidacionStatus {
  Borrador
  Revision
  Aprobada
  Pendiente
  Enviada
  Pagada
  Vencida
  Anulada
}

enum PaymentMethod {
  Transferencia
  Efectivo
  MercadoPago
  Cheque
}

enum LineItemType {
  Alquiler
  Ajuste
  Extra
  Descuento
  Multa
}

// ─── Liquidacion Models ─────────────────────────────────

model Liquidacion {
  id           String             @id @default(uuid())
  tenantId     String
  contractId   String
  period       DateTime
  status       LiquidacionStatus  @default(Borrador)
  dueDate      DateTime
  subtotal     Decimal            @db.Decimal(15, 2)
  total        Decimal            @db.Decimal(15, 2)
  currency     Currency           @default(ARS)
  notes        String?
  pdfUrl       String?
  sentAt       DateTime?
  paidAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  contract         Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lineItems        LiquidacionLineItem[]
  payments         Payment[]

  penalties        Penalty[]               @relation("PenaltyLiquidacion")
  settledPenalties Penalty[]               @relation("PenaltySettledLiquidacion")

  @@unique([contractId, period])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, contractId, period])
  @@map("liquidaciones")
}

model LiquidacionLineItem {
  id             String       @id @default(uuid())
  tenantId       String
  liquidacionId  String
  type           LineItemType
  description    String
  amount         Decimal      @db.Decimal(15, 2)
  currency       Currency     @default(ARS)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  liquidacion Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([liquidacionId])
  @@map("liquidacion_line_items")
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String
  liquidacionId  String
  amount         Decimal       @db.Decimal(15, 2)
  currency       Currency      @default(ARS)
  method         PaymentMethod
  reference      String?
  notes          String?
  paidAt         DateTime
  createdAt      DateTime      @default(now())

  liquidacion Liquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  comprobantes Comprobante[]

  @@index([tenantId])
  @@index([liquidacionId])
  @@map("payments")
}

// ─── Service Enums ──────────────────────────────────────

enum ServiceType {
  Electricidad
  Gas
  Agua
  Internet
  Expensas
  Municipal
  Otro
}

// ─── Service Models ─────────────────────────────────────

model Service {
  id            String      @id @default(uuid())
  tenantId      String
  propertyId    String
  serviceType   ServiceType
  providerName  String?
  accountNumber String?
  amount        Decimal     @db.Decimal(15, 2)
  currency      Currency    @default(ARS)
  dueDay        Int
  isActive      Boolean     @default(true)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  property Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments ServicePayment[]

  @@index([tenantId])
  @@index([tenantId, propertyId])
  @@index([tenantId, isActive])
  @@map("services")
}

model ServicePayment {
  id          String   @id @default(uuid())
  tenantId    String
  serviceId   String
  amount      Decimal  @db.Decimal(15, 2)
  paymentDate DateTime
  period      DateTime
  notes       String?
  createdAt   DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([serviceId])
  @@map("service_payments")
}

enum PenaltyStatus {
  active
  waived
}

model Penalty {
  id                    String        @id @default(uuid())
  tenantId              String
  liquidacionId         String
  amount                Decimal       @db.Decimal(14, 2)
  appliedOn             DateTime
  daysOverdue           Int
  compoundBase          Decimal?      @db.Decimal(14, 2)
  status                PenaltyStatus @default(active)
  waivedAt              DateTime?
  waivedBy              String?       // userId
  waiveReason           String?
  settledLiquidacionId  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  liquidacion        Liquidacion  @relation("PenaltyLiquidacion", fields: [liquidacionId], references: [id], onDelete: Cascade)
  settledLiquidacion Liquidacion? @relation("PenaltySettledLiquidacion", fields: [settledLiquidacionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([liquidacionId])
  @@index([settledLiquidacionId])
  @@map("penalties")
}

