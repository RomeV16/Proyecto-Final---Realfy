// ─── Facturación electrónica (ARCA) ───────────────────────────────────────────

enum ComprobanteType {
  FacturaA
  FacturaB
  FacturaC
  NotaCreditoA
  NotaCreditoB
  NotaCreditoC
  NotaDebitoA
  NotaDebitoB
  NotaDebitoC
}

enum ComprobanteStatus {
  Emitido
  Anulado
}

enum ArcaDelegationStatus {
  Pending
  Active
  Revoked
}

/// Digital certificate used to authenticate against ARCA's WSAA. The PEM cert
/// and its private key are stored under envelope encryption: the payload is
/// sealed with a per-row DEK, and the DEK itself is wrapped with the master key.
model ArcaCertificate {
  id            String   @id @default(uuid())
  tenantId      String   @unique
  commonName    String
  notBefore     DateTime
  notAfter      DateTime
  isProduction  Boolean  @default(false)
  isActive      Boolean  @default(true)
  certEncrypted Bytes
  keyEncrypted  Bytes
  dekWrapped    Bytes
  kekVersion    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accessLogs ArcaCertificateAccessLog[]

  @@map("arca_certificates")
}

/// Audit trail for every decryption of the private key, so a leak can be traced
/// to the actor and the reason that unsealed it.
model ArcaCertificateAccessLog {
  id            String   @id @default(uuid())
  tenantId      String
  certificateId String
  actor         String
  reason        String
  createdAt     DateTime @default(now())

  certificate ArcaCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([tenantId, certificateId])
  @@index([tenantId, createdAt])
  @@map("arca_certificate_access_logs")
}

/// A CUIT the agency can invoice as: either its own (isSelf) or a represented
/// owner that delegated the WSFE service to it in ARCA.
model ArcaIssuer {
  id                   String               @id @default(uuid())
  tenantId             String
  cuit                 String
  businessName         String
  fiscalCondition      FiscalCondition
  ingresosBrutos       String?
  activityStartDate    String?
  businessAddress      String?
  delegationStatus     ArcaDelegationStatus @default(Pending)
  delegationVerifiedAt DateTime?
  delegationLastError  String?
  isSelf               Boolean              @default(false)
  isActive             Boolean              @default(true)
  /// Locador por cuenta del cual la inmobiliaria factura (delegación ARCA); vacío = emisor propio.
  personId             String?
  /// Qué y cuándo se factura de este locador; vacío = valores de la inmobiliaria.
  invoicingSettings    Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person        Person?            @relation("PersonDelegatedIssuer", fields: [personId], references: [id], onDelete: Restrict)
  puntosDeVenta ArcaPuntoDeVenta[]
  comprobantes  Comprobante[]

  @@unique([tenantId, cuit])
  @@unique([tenantId, personId])
  @@index([tenantId])
  @@map("arca_issuers")
}

model ArcaPuntoDeVenta {
  id         String    @id @default(uuid())
  tenantId   String
  issuerId   String
  number     Int
  nombre     String?
  tipo       String?
  bloqueado  Boolean   @default(false)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  issuer ArcaIssuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)

  @@unique([issuerId, number])
  @@index([tenantId, issuerId])
  @@map("arca_puntos_de_venta")
}

/// Request/response envelope for every ARCA call. Kept verbatim because AFIP
/// rejections only make sense next to the exact payload that produced them.
model ArcaRequestLog {
  id              String   @id @default(uuid())
  tenantId        String
  issuerId        String?
  operation       String
  issuerCuit      String?
  requestPayload  Json?
  responsePayload Json?
  latencyMs       Int
  success         Boolean
  errorCode       String?
  errorMessage    String?
  comprobanteId   String?
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, issuerId, createdAt])
  @@map("arca_request_logs")
}

/// A comprobante that ARCA authorised. Amounts stay Decimal end to end and the
/// (issuerId, puntoDeVenta, cbteTipo, numero) key is unique per tenant because
/// AFIP numbering must have no gaps and no repeats for each issuer.
model Comprobante {
  id                      String            @id @default(uuid())
  tenantId                String
  paymentId               String?
  issuerId                String
  clientRequestId         String?
  type                    ComprobanteType
  status                  ComprobanteStatus @default(Emitido)
  cbteTipo                Int
  puntoDeVenta            Int
  numero                  Int
  concepto                Int               @default(2)
  docTipo                 Int
  docNro                  String
  receptorName            String
  receptorFiscalCondition FiscalCondition
  condicionIVAReceptorId  Int?
  impTotal                Decimal           @db.Decimal(15, 2)
  impNeto                 Decimal           @db.Decimal(15, 2)
  impIva                  Decimal           @db.Decimal(15, 2)
  impExento               Decimal           @db.Decimal(15, 2)
  impTotConc              Decimal           @default(0) @db.Decimal(15, 2)
  impOpEx                 Decimal           @default(0) @db.Decimal(15, 2)
  impTrib                 Decimal           @default(0) @db.Decimal(15, 2)
  monId                   String            @default("PES")
  monCotiz                Decimal           @default(1) @db.Decimal(12, 6)
  currency                Currency
  cae                     String
  caeFchVto               DateTime
  emittedAt               DateTime
  fchServDesde            DateTime?
  fchServHasta            DateTime?
  fchVtoPago              DateTime?
  periodoAsocDesde        DateTime?
  periodoAsocHasta        DateTime?
  pdfUrl                  String?
  originalComprobanteId   String?
  ivaArray                Json?
  tributos                Json?
  opcionales              Json?
  cbtesAsoc               Json?
  createdAt               DateTime          @default(now())
  /// Cuota de honorario que se factura (D10).
  feeInstallmentId        String?
  /// Estado de cuenta del locador del que sale la factura emitida por su cuenta.
  ownerStatementId        String?

  payment             Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  issuer              ArcaIssuer    @relation(fields: [issuerId], references: [id])
  originalComprobante Comprobante?  @relation("ComprobanteNC", fields: [originalComprobanteId], references: [id])
  creditNotes         Comprobante[] @relation("ComprobanteNC")

  feeInstallment    FeeInstallment?    @relation(fields: [feeInstallmentId], references: [id], onDelete: SetNull)
  ownerStatement    OwnerStatement?    @relation(fields: [ownerStatementId], references: [id], onDelete: SetNull)
  lessorInvoiceJobs LessorInvoiceJob[]

  // ARCA numera por CUIT, punto de venta y tipo: dos emisores de la misma
  // inmobiliaria pueden tener el mismo numero en el mismo punto de venta.
  @@unique([tenantId, issuerId, puntoDeVenta, cbteTipo, numero])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId])
  @@index([tenantId, paymentId])
  @@index([tenantId, issuerId])
  @@index([feeInstallmentId])
  @@index([ownerStatementId])
  @@map("comprobantes")
}

/// Monthly IVA ventas book exported to Excel and parked in object storage, one
/// row per tenant/period so a regenerated period replaces the previous file.
model LibroIvaExport {
  id          String   @id @default(uuid())
  tenantId    String
  period      String
  rowCount    Int
  s3Key       String
  fileUrl     String
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("libro_iva_exports")
}

