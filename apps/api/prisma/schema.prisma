  tenantId             String   @unique
  guaranteeWeight      Int      @default(20)
  jobStabilityWeight   Int      @default(20)
  referencesWeight     Int      @default(20)
  paymentHistoryWeight Int      @default(20)
  manualRatingWeight   Int      @default(20)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_score_configs")
}

model TenantScore {
  id                  String   @id @default(uuid())
  tenantId            String
  personId            String
  guaranteeScore      Int      @default(0)
  jobStabilityScore   Int      @default(0)
  referencesScore     Int      @default(0)
  paymentHistoryScore Int      @default(0)
  manualRating        Int      @default(0)
  totalScore          Decimal  @default(0) @db.Decimal(5, 2)
  notes               String?
  scoredByUserId      String
  scoredAt            DateTime @default(now())
